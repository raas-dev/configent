[Unit]
Description=XFCE desktop session on :0 (always-on, display-manager-independent)
After=xvfb.service
Wants=network-online.target

[Service]
User=__LUSER__
Group=__LGROUP__
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/__LUID__
Environment=XDG_CURRENT_DESKTOP=XFCE
Environment=XDG_SESSION_DESKTOP=xfce
Environment=XDG_DATA_DIRS=/home/__LUSER__/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share
Environment=GTK_A11Y=atspi
ExecStartPre=/bin/sh -c "until [ -S /tmp/.X11-unix/X0 ]; do sleep 1; done"
ExecStartPre=/usr/bin/dbus-update-activation-environment --systemd DISPLAY XDG_RUNTIME_DIR
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/startxfce4
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
