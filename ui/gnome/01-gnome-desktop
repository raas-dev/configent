# Desktop defaults: dark classic theme, no lock/idle, fixed wallpaper.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/gnome/adwaita-l.jxl'
picture-uri-dark='file:///usr/share/backgrounds/gnome/adwaita-d.jxl'

[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/interface]
# a11y: GTK3 apps (panel, metacity, gnome-terminal) load atk-bridge only when
# this is true; AT-SPI consumers (open-computer-use) need it on the session bus
toolkit-accessibility=true
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'
monospace-font-name='Ubuntu Mono 13'

[org/gnome/desktop/wm/preferences]
theme='TraditionalOk'
