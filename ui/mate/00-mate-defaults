# MATE desktop defaults — captured live from a running VM with “dconf dump /org/mate/"
# followed by /org/gtk/ and /org/gnome/desktop/. Path prefixes reattached
# so this file load-checks under a system-db (`sudo dconf update` sees it).
# Edit settings live via dconf-editor / mate-control-center + SettingsDaemon,
# then re-run the dump command in bin/install_linux_mate to refresh.
#
# Excluded on purpose:
#   [caja/window-state] geometry  — per-display, breaks on resize
#   panel position/x/y/size/expand — pinned by ubuntu-mate.layout

[org/mate/Marco/general]
compositing-manager=false
theme='ClearlooksRe'
titlebar-font='Ubuntu Bold 10'

[org/mate/NotificationDaemon]
do-not-disturb=true
sound-enabled=false

[org/mate/SettingsDaemon/plugins/background]
active=false

[org/mate/background]
color-shading-type='solid'
picture-filename='/usr/share/backgrounds/wallpaper-radioactive.jpg'
picture-options='zoom'
primary-color='#3C3B37'
secondary-color='#3C3B37'

[org/mate/background/desktop-backgrounds/0]
filename='/usr/share/backgrounds/wallpaper-radioactive.jpg'
options='zoom'
primary-color='#3C3B37'
secondary-color='#3C3B37'

[org/mate/caja/desktop]
