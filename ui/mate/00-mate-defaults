# MATE desktop defaults — applies to every user at first login.
# Sourced from webtop/docker-webtop (ubuntu-mate branch) + corrected for the
# gaps ubuntu-mate-default-settings leaves behind.

[org/mate/Marco/general]
compositing-manager=false
titlebar-font='Ubuntu Bold 10'
theme='ClearlooksRe'


[org/mate/background]
primary-color='#3C3B37'
secondary-color='#3C3B37'
color-shading-type='solid'
# Ship our own: gocemitevski/ubuntu-mate-wallpapers Radioactive no-logo.
# All -wallpapers-* apt pkgs removed — only this file is installed.
picture-filename='/usr/share/backgrounds/wallpaper-radioactive.jpg'
picture-options='zoom'

[org/mate/background/desktop-backgrounds/0]
filename='/usr/share/backgrounds/wallpaper-radioactive.jpg'
options='zoom'
primary-color='#3C3B37'
secondary-color='#3C3B37'

[org/mate/desktop/interface]
gtk-theme='Yaru-olive-dark'
icon-theme='Yaru-olive-dark'

# Panel clock: show seconds + date.
# Fonts live on org.gnome.desktop.interface (path /org/gnome/desktop/interface),
# NOT org.mate.interface (path /org/mate/desktop/interface). Earlier drafts
# put them in [org/mate/desktop/interface] and dconf wrote them to a path
# no schema reads, so fresh users got the upstream 'Sans 10' default.
[org/gnome/desktop/interface]
font-name='Ubuntu 10'
document-font-name='Ubuntu 10'
monospace-font-name='Terminess Nerd Font Mono 11'
clock-show-seconds=true
clock-show-date=true
# AT-SPI2 master switch. Without this, GTK widgets are invisible to Orca.
toolkit-accessibility=true
[org/mate/panel/objects/clock/prefs]
# Path MUST be /objects/clock/prefs (the live applet), not
# /applets/clock_applet/prefs (a no-op relocatable path).
show-seconds=true
show-date=true
# Custom format is mandatory: the preset '24-hour' ignores show-seconds.
format='custom'
custom-format='%a %d %b  %H:%M:%S'

[org/mate/caja/preferences]
show-desktop-icons=true
# Show foo~ backup files. Upstream default already true; pinned for VM
# recreate + grep-ability.
show-backup-files=true
# Arrange items by type; tighter (compact) layout for icon view.
default-sort-order='type'
sort-directories-first=true

# Don't pop a Caja window when removable media gets inserted.
# Drives still auto-mount (automount=true), the icon just stays in the side
# panel until the user clicks it.
[org/mate/media-handling]
automount-open=false

[org/mate/caja/icon-view]
default-use-tighter-layout=false

# Desktop icon font: stock Ubuntu 11 is too big on a 1280×720 selkies canvas.
[org/mate/caja/desktop]
font='Ubuntu 10'

# mate-terminal default profile. System monospace font, I-beam, blink on,
# 120×35 custom size, silent bell, auto-copy selection to clipboard,
# unlimited scrollback. font key is the fallback if use-system-font is off.
[org/mate/terminal/profiles/default]
use-system-font=false
silent-bell=true
copy-selection=true
cursor-shape='ibeam'
cursor-blink-mode='on'
allow-bold=true
use-custom-default-size=true
default-size-columns=120
default-size-rows=35
scrollback-unlimited=true
palette='#000000000000:#CCCC00000000:#4E4D9A9A0605:#C4C3A0A00000:#34346564A4A3:#7575504F7B7B:#060598979A9A:#D3D3D7D6CFCF:#555457565352:#EFEF29282928:#8A89E2E23434:#FCFBE9E84F4F:#72729F9ECFCF:#ADAC7F7EA8A8:#3434E2E2E2E2:#EEEDEEEDECEB'
foreground-color='#FFFFFFFFDDDD'
background-color='#000000000000'
font='Terminess Nerd Font Mono 11'

# GTK file chooser: show dotfiles by default.
[org/gtk/settings/file-chooser]
show-hidden=true
[org/gtk/file-chooser]
show-hidden=true

# Taller menu bar — default 24 leaves no breathing room next to app icons.
# Both panels span full width (expand=true) so neither renders ~70% wide.
# Panel schema: relocatable per-toplevel id. Real path mate-panel writes
# to is /toplevels/<id> (note trailing 's'). Earlier drafts used the
# singular /toplevel/<id> and every panel-size write was a silent no-op
# — the bottom panel rendered without expand and looked ~70% wide.
[org/mate/panel/toplevels/top]
size=32
expand=true
auto-hide=false
[org/mate/panel/toplevels/bottom]
size=32
expand=true
auto-hide=false

[org/mate/panel/general]
default-layout='ubuntu-mate'

# Keyboard indicator (libmatekbd) in system tray: two layouts → tray icon
# appears automatically.  single layout → tray auto-hides.
[org/mate/peripherals-keyboard-xkb/general]
known-file-list=['fi', 'us']
default-group=0
handle-indicators=true
disable-indicator=false

# Background plugin resets picture-filename on every theme change. Disable
# so our wallpaper sticks; caja-desktop paints directly via GSettings.
[org/mate/SettingsDaemon/plugins/background]
active=false

# Screensaver: autostart file deletion is not enough; the schema still
# defaults idle-activation=true. Pin it false system-wide.
[org/mate/screensaver]
idle-activation-enabled=false
lock-enabled=false
mode='blank-only'
delay=0

# Notification daemon: kill alert sound + notifications while focus.
# sound-enabled=false stops the per-notification audio cue; do-not-disturb
# also suppresses the popup itself. Both are needed because sound-enabled
# only controls audio, not visual notification.
[org/mate/NotificationDaemon]
sound-enabled=false
do-not-disturb=true

# Sound: mute all event/alert sounds.
# theme-name='__custom' points libcanberra at ~/.local/share/sounds/__custom
# (does not exist) so every alert/warning/error/dialog cue is silent.
[org/mate/sound]
event-sounds=false
input-feedback-sounds=false
theme-name='__custom'

# Belt-and-suspenders: GNOME desktop-sound schema. Some apps (notably
# GTK3/4 dialogs, Evolution, third-party snaps) read this rather than
# org.mate.sound. Disable on both schemas so no path stays open.
[org/gnome/desktop/sound]
event-sounds=false
input-feedback-sounds=false
theme-name='__custom'

# System bell (X11 beep from terminals, dialog errors, completion cues).
# Distinct from event-sounds — that flag controls libcanberra, this one
# controls the kernel/PulseAudio bell. Off silences the terminal bell
# without killing actual media playback paths.
[org/mate/peripherals-keyboard]
bell-mode='off'
