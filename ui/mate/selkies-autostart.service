[Unit]
Description=Selkies web desktop on :8080 (always-on, MATE-independent)
After=xorg-dummy.service selkies-tls.service
Wants=network-online.target

[Service]
User=__LUSER__
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/__LUID__
ExecStartPre=/bin/sh -c "until [ -S /tmp/.X11-unix/X0 ]; do sleep 1; done"
ExecStart=/mnt/lima-limahome/.local/bin/selkies-session
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
