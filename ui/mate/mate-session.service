[Unit]
Description=MATE desktop session on :0 (always-on, display-manager-independent)
After=xvfb.service
Wants=network-online.target

[Service]
User=__LUSER__
Group=__LGROUP__
Environment=DISPLAY=:0
Environment=XDG_CURRENT_DESKTOP=MATE
Environment=XDG_SESSION_DESKTOP=mate
Environment=GTK_A11Y=atspi
ExecStartPre=/bin/sh -c "until [ -S /tmp/.X11-unix/X0 ]; do sleep 1; done"
ExecStartPre=/usr/bin/dbus-update-activation-environment --systemd DISPLAY
ExecStart=/usr/bin/mate-session
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
