#!/bin/sh
# configent (https://github.com/raas-dev/configent)
# CloakBrowser launcher. First Run sentinel in the seeded profile
# (ui/chromium) replaces --no-first-run,
# browser.check_default_browser=false in Preferences replaces
# --no-default-browser-check, and extensions load from the store CRXs
# unpacked by ui/chromium/extensions.py into ~/.config/chromium-extensions/
# (Chromium refuses hand-registered user extensions, so no seeding of
# extensions.settings — --load-extension is the only user-space way without
# enterprise policy).
#
# CHROME_DESKTOP: unbranded Chromium derives its desktop-file identity from
# this env var (fallback: chromium-browser.desktop) and compares it against
# the xdg default-web-browser to decide "is default". The installed desktop
# file IS chromium-browser.desktop, so export it explicitly — without it the
# self-check can mismatch and the "isn't your default browser" infobar
# shows on every launch.
export CHROME_DESKTOP=chromium-browser.desktop
CBHOME=${HOME:-/root}/.local/share/cloakbrowser
# Newest version dir wins — find order is readdir order, not sorted.
CRBIN=$(find "$CBHOME" -maxdepth 2 -name chrome -print 2>/dev/null | sort -V | tail -1)
# ponytail: fail-fast guard. If the user-local cloakbrowser tree is missing
# or the file there is something else (e.g. system chromium), refuse to
# silently exec the wrong browser. Drop when a real /usr/bin/cloak-browser
# shim exists and CRBIN is hardcoded.
case "$CRBIN" in
"$CBHOME"/*) ;;
*)
  echo "chromium-wrapper: cloakbrowser not found at $CBHOME/ (got: ${CRBIN:-<none>})" >&2
  exit 127
  ;;
esac
EXTS=${HOME:-/root}/.config/chromium-extensions
# Terminal logins (limactl/ssh) get the systemd user bus
# (/run/user/UID/bus), but pass-secret-service
# (org.freedesktop.secrets, backing --password-store=gnome-libsecret)
# only runs on the XFCE session bus. Chromium 143+ inits os_crypt async
# in the network service; without the secret service it crash-loops
# ("Network service crashed or was terminated") and pages never load.
# Adopt the graphical session's bus when ours lacks the secret service.
# Candidate buses are VERIFIED to serve org.freedesktop.secrets before
# adoption: pgrep -n (newest) alone is wrong — transient xfce4-session/
# xfdesktop respawns can carry the systemd user bus (no secrets) and be
# newer than the real desktop session, and adopting that bus keeps the
# network service crash-looping. pass-secret-service is checked first:
# its own bus IS the secrets bus by definition.
_secrets_on_bus() {
  DBUS_SESSION_BUS_ADDRESS="$1" dbus-send --session --print-reply \
    --dest=org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus.NameHasOwner string:org.freedesktop.secrets 2>/dev/null |
    grep -q 'boolean true'
}
if command -v dbus-send >/dev/null 2>&1 &&
  ! dbus-send --session --print-reply --dest=org.freedesktop.DBus \
    /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner \
    string:org.freedesktop.secrets 2>/dev/null | grep -q "boolean true"; then
  _ADOPTED=
  # Candidate bus addresses: procs' DBUS env first (pass-secret-service is
  # authoritative — its bus IS the secrets bus), then the user bus itself:
  # a systemd user unit instance serves secrets there without DBUS_SESSION_
  # BUS_ADDRESS in its environ.
  _CAND=$(
    for _P in $(pgrep -f "pass-secret-service" 2>/dev/null) \
      $(pgrep -x xfce4-session 2>/dev/null) \
      $(pgrep -x xfdesktop 2>/dev/null); do
      tr '\0' '\n' </proc/"$_P"/environ 2>/dev/null |
        sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -1
    done
    echo "unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
  )
  for _BUS in $_CAND; do
    [ -n "${_BUS:-}" ] || continue
    [ "$_BUS" != "${DBUS_SESSION_BUS_ADDRESS:-}" ] || continue
    if _secrets_on_bus "$_BUS"; then
      export DBUS_SESSION_BUS_ADDRESS="$_BUS"
      _ADOPTED=yes
      break
    fi
  done
  [ -n "${_ADOPTED:-}" ] || echo "chromium-wrapper: no session bus with org.freedesktop.secrets found; password store unavailable" >&2
fi
# --password-store=gnome-libsecret: passwords go to pass-secret-service
# (org.freedesktop.secrets, D-Bus activated) backed by the pass store
# seeded by bin/install_linux_apps — empty-passphrase GPG key, so no
# unlock prompt; plaintext basic store would instead write Login Data
# unencrypted into the profile.
# Software GPU path for lima/krunkit VMs: real virtio-gpu is plumbed but
# Venus is blocked by libkrun #114 (Apple Silicon blob alignment).
# WebGL renders via ANGLE->native GL->Mesa llvmpipe (CPU, GL 4.5 core).
exec "$CRBIN" \
  --force-renderer-accessibility --ignore-gpu-blocklist \
  --use-gl=angle --use-angle=gl \
  --enable-features=WebGPU \
  --no-default-browser-check \
  --password-store=gnome-libsecret \
  --load-extension="$EXTS/ddkjiahejlhfcafbddmgiahcphecmpfh,$EXTS/edibdbjcniadpccecjdfdjjppcpchdlm" \
  "$@"
