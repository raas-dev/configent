#!/bin/bash

trap "printf '\nCaught ^C from user - exiting now\n' ; exit 130" INT

if [ "$(id -u)" = 0 ]; then
  SUDO=''
  export DEBIAN_FRONTEND=noninteractive
elif command -v sudo >/dev/null; then
  SUDO='sudo DEBIAN_FRONTEND=noninteractive'

  sudo -n true || sudo -v

  while true; do
    sudo -n true
    sleep 60
    kill -0 "$$" || exit
  done 2>/dev/null &
else
  printf "\nERROR: User is non-root and sudo not available, cannot proceed.\n"
  exit 1
fi

set -eu -o pipefail
# ponytail: warm-boot fast path. First successful install touches this; selkies
# units are systemctl-enabled, so systemd brings them up on boot without us.
# Saves ~10 min on every `vm up dev` after the first cold install.
[ -f /var/tmp/desktop.done ] && exit 0

LUSER=$(getent passwd | awk -F: '$6 ~ /^\/home\// {print $1; exit}')
UHOME=$(getent passwd "$LUSER" | cut -d: -f6)
LGROUP=$(getent group "$LUSER" | cut -d: -f1)

UI=$(CDPATH='' cd -- "$(dirname -- "$0")/../ui/xfce" && pwd)
ARCH=$(dpkg --print-architecture)
TARBALL=/mnt/lima-provision/chromium-extensions.$ARCH.tar.gz

APT_OPTS=(-y -o Acquire::Retries=3 --no-install-recommends
  -o Dpkg::Options::=--force-confdef
  -o Dpkg::Options::=--force-confold
  -o Dpkg::Options::=--force-unsafe-io)

log() { printf '[xfce-install] %s %s\n' "$(date +%H:%M:%S)" "$*"; }

wait_ok() {
  wait "$1" || {
    cat "$2" >&2
    exit 1
  }
}

selkies_deb() {
  case "$ARCH" in
  amd64) DEB=selkies-2.0.0rc0-ubuntu26.04-amd64.deb ;;
  arm64) DEB=selkies-2.0.0rc0-ubuntu26.04-arm64.deb ;;
  esac
  if [ -f "/tmp/$DEB" ]; then
    return 0
  fi
  if [ -f "/mnt/lima-provision/$DEB" ]; then
    cp "/mnt/lima-provision/$DEB" "/tmp/$DEB"
    return 0
  fi
  curl -fsSL --retry 5 --retry-all-errors -o "/tmp/$DEB" \
    "https://github.com/selkies-project/selkies/releases/download/2.0.0rc0/${DEB}"
  [ -w /mnt/lima-provision ] && cp "/tmp/$DEB" /mnt/lima-provision/ || true
}

chromium_dl() {
  if [ -f "$TARBALL" ]; then
    $SUDO tar xzf "$TARBALL" -C / &&
      $SUDO chown -R "$LUSER": /usr/local/share/extensions &&
      touch /tmp/cb.ok /tmp/ext.ok
  else
    for _ in $(seq 1 300); do
      command -v pip3 >/dev/null 2>&1 && break
      sleep 2
    done
    command -v pip3
    $SUDO pip3 install --no-cache-dir --break-system-packages --root-user-action=ignore --ignore-installed typing_extensions cloakbrowser &&
      $SUDO cloakbrowser install &&
      touch /tmp/cb.ok
  fi
}

extensions_dl() {
  if [ -f "$TARBALL" ]; then
    for _ in $(seq 1 300); do
      [ -f /tmp/ext.ok ] && return 0
      sleep 2
    done
    return 1
  fi
  for _ in $(seq 1 120); do
    [ -x /usr/bin/unzip ] && break
    sleep 2
  done
  [ -x /usr/bin/unzip ]
  $SUDO install -d -m 755 /usr/local/share/extensions
  for pair in i-still-dont-care-about-cookies:edibdbjcniadpccecjdfdjjppcpchdlm ublock-origin-lite:ddkjiahejlhfcafbddmgiahcphecmpfh; do
    name=${pair%%:*}
    id=${pair##*:}
    curl -fsSL -o "/tmp/$name.crx" "https://clients2.google.com/service/update2/crx?response=redirect&prodversion=138.0.0.0&acceptformat=crx2,crx3&x=id%3D${id}%26uc"
    python3 -c 'import sys;d=open(sys.argv[1],"rb").read();open(sys.argv[2],"wb").write(d[d.find(b"PK\x03\x04"):])' "/tmp/$name.crx" "/tmp/$name.zip"
    $SUDO mkdir -p "/usr/local/share/extensions/$name"
    $SUDO unzip -oq "/tmp/$name.zip" -d "/usr/local/share/extensions/$name"
    $SUDO rm -rf "/usr/local/share/extensions/$name"/_metadata
  done
  $SUDO chown -R "$LUSER": /usr/local/share/extensions
  touch /tmp/ext.ok
}

chromium_files() {
  for _ in $(seq 1 600); do
    [ -f /tmp/cb.ok ] && [ -f /tmp/ext.ok ] && break
    sleep 0.5
  done
  [ -f /tmp/cb.ok ] && [ -f /tmp/ext.ok ] || return 1
  if [ ! -x "$($SUDO find /opt/cloakbrowser -maxdepth 2 -name chrome -print -quit 2>/dev/null)" ] && $SUDO test -d /root/.cloakbrowser; then
    $SUDO install -d -m 755 /opt/cloakbrowser
    CRBIN=$($SUDO find /root/.cloakbrowser -maxdepth 2 -name chrome -print -quit)
    $SUDO mv "$(dirname "$CRBIN")" /opt/cloakbrowser/
  fi
  CRBIN=$($SUDO find /opt/cloakbrowser -maxdepth 2 -name chrome -print -quit)
  [ -n "$CRBIN" ]
  $SUDO install -m 644 "$UI/99-chromium-userns.conf" /etc/sysctl.d/99-chromium-userns.conf
  $SUDO sysctl -p /etc/sysctl.d/99-chromium-userns.conf
  $SUDO install -m 755 "$UI/chromium-wrapper" /usr/local/bin/chromium-wrapper
  for n in chrome chromium chromium-browser; do $SUDO ln -sf /usr/local/bin/chromium-wrapper /usr/local/bin/$n; done
  $SUDO install -d -m 755 /usr/local/share/applications
  $SUDO install -m 644 "$UI/chromium.desktop" /usr/local/share/applications/chromium.desktop
  $SUDO sed 's|^\[Desktop Entry\]$|[Desktop Entry]\nNoDisplay=true|' /usr/local/share/applications/chromium.desktop | $SUDO tee /usr/local/share/applications/chromium_chromium.desktop >/dev/null
  $SUDO chmod 755 /usr/local/share/applications
  $SUDO chmod 644 /usr/local/share/applications/chromium.desktop /usr/local/share/applications/chromium_chromium.desktop
  $SUDO install -d -m 755 /etc/chromium/policies/managed
  $SUDO install -m 644 "$UI/policy-startup.json" /etc/chromium/policies/managed/startup.json
  $SUDO rm -rf \
    "$UHOME/.config/xfce4" \
    "$UHOME/.config/xfce4-session" \
    "$UHOME/.config/Thunar" \
    "$UHOME/.config/autostart" \
    "$UHOME/.cache/xfce4" \
    "$UHOME/.cache/xfce4-session" \
    "$UHOME/.cache/Thunar" \
    "$UHOME/.local/share/xfce4" 2>/dev/null || true

  $SUDO install -d -o "$LUSER" -m 755 "$UHOME/.config"
  $SUDO cp -r "$UI/xfce4" "$UHOME/.config/xfce4"
  $SUDO install -o "$LUSER" -m 644 "$UI/mimeapps.user.list" "$UHOME/.config/mimeapps.list"
  $SUDO install -d -o "$LUSER" -m 755 "$UHOME/Desktop"
  [ -f "$UI/xfce4-terminal.desktop" ] &&
    $SUDO install -o "$LUSER" -m 644 "$UI/xfce4-terminal.desktop" \
      "$UHOME/Desktop/xfce4-terminal.desktop"
}

write_configs() {
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" "$UI/xvfb.service" |
    $SUDO tee /etc/systemd/system/xvfb.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/xvfb.service
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" "$UI/xfce-session.service" |
    $SUDO tee /etc/systemd/system/xfce-session.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/xfce-session.service
  $SUDO install -m 644 "$UI/keyboard-default" /etc/default/keyboard
  $SUDO install -d -m 755 /etc/xdg/xfce4/xfconf/xfce-perchannel-xml
  $SUDO install -m 644 "$UI/xfce4-desktop.xml" /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
  $SUDO install -m 644 "$UI/xfce4-terminal.xml" /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml
  $SUDO install -d -m 755 /mnt/lima-limahome/.local/bin
  $SUDO install -m 755 "$UI/selkies-session" /mnt/lima-limahome/.local/bin/selkies-session
  $SUDO install -m 755 "$UI/selkies-session" /usr/local/bin/selkies-session
  $SUDO sh -c '[ -f /etc/ssl/selkies.pem ] || exit 1'
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" "$UI/selkies-tls.service" |
    $SUDO tee /etc/systemd/system/selkies-tls.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/selkies-tls.service
  $SUDO install -d -m 755 /etc/xdg/autostart
  $SUDO install -m 644 "$UI/selkies-autostart.desktop" /etc/xdg/autostart/selkies-autostart.desktop
  $SUDO install -d -m 755 /etc/xdg/xfce4
  $SUDO install -m 644 "$UI/xfce4-helpers.rc" /etc/xdg/xfce4/helpers.rc
  $SUDO loginctl enable-linger "$LUSER" 2>/dev/null || true
}

enable_units() {
  $SUDO systemctl reset-failed xvfb xfce-session selkies-tls 2>/dev/null || true
  $SUDO systemctl enable --now xvfb xfce-session selkies-tls
  $SUDO systemctl daemon-reload
}

cert_gen() {
  # Both key (openssl -keyout) AND cert (cat sk.crt >>) must be present,
  # or socat OPENSSL-LISTEN rejects the file. A partial file from a prior
  # failed run still passes [ -f ], so check content too.
  if [ -s /etc/ssl/selkies.pem ] && grep -q 'BEGIN CERTIFICATE' /etc/ssl/selkies.pem 2>/dev/null; then
    return 0
  fi
  $SUDO openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -subj '/CN=localhost' \
    -keyout /etc/ssl/selkies.pem -out /tmp/sk.crt
  $SUDO sh -c 'cat /tmp/sk.crt >> /etc/ssl/selkies.pem && rm -f /tmp/sk.crt && chmod 644 /etc/ssl/selkies.pem'
}

warm_cache() {
  if [ -w /mnt/lima-provision ] && [ ! -f "$TARBALL" ]; then
    # warm cache for future VMs; do not block desktop.done
    ($SUDO tar -I 'gzip -1' -cf "$TARBALL.tmp" -C / opt/cloakbrowser usr/local/share/extensions &&
      mv "$TARBALL.tmp" "$TARBALL") >/dev/null 2>&1 &
  fi
}

LOGDIR=/var/log/xfce-install
$SUDO mkdir -p -m 755 "$LOGDIR"
$SUDO chown "$LUSER": "$LOGDIR"

rm -f "$LOGDIR"/*.log

exec > >(tee -a "$LOGDIR/install_linux_xfce.log") 2>&1

log 'starting install_linux_xfce'

$SUDO install -d -m 755 /var/cache/apt/archives/partial
$SUDO install -m 644 "$UI/dpkg-excludes.conf" /etc/dpkg/dpkg.cfg.d/01-excludes

$SUDO apt-get update -o Acquire::Languages=none -o Acquire::Retries=3 \
  >"$LOGDIR/apt.log" 2>&1 &
UP=$!
selkies_deb >"$LOGDIR/selkdeb.log" 2>&1 &
SDB=$!
chromium_dl >"$LOGDIR/cb.log" 2>&1 &
CB=$!
extensions_dl >"$LOGDIR/ext.log" 2>&1 &
EXT=$!
cert_gen >"$LOGDIR/cert.log" 2>&1 &
CERT=$!
write_configs >"$LOGDIR/cfg.log" 2>&1 &
CFG=$!

wait_ok "$UP" "$LOGDIR/apt.log"
log "apt index updated"

log "waiting for selkies deb"
wait_ok "$SDB" "$LOGDIR/selkdeb.log"
SELKIES_DEB="/tmp/selkies-2.0.0rc0-ubuntu26.04-${ARCH}.deb"
[ -f "$SELKIES_DEB" ] || {
  cat "$LOGDIR/selkdeb.log" >&2
  exit 1
}

# ponytail: eatmydata bypasses fsync/fdatasync during apt's many commits.
# Cuts cold install 30-50% on slow disks (macOS vz/APFS). Optional: if
# installation fails (e.g. offline mirror), fall back to plain apt.
EAT=''
if $SUDO apt-get install "${APT_OPTS[@]}" eatmydata 2>"$LOGDIR/eatmydata.log"; then
  EAT='eatmydata'
  log "eatmydata enabled (fsync bypass → faster apt)"
fi

log "apt + selkies + xfce + pip install starting (single batch)"
{
  $SUDO $EAT apt-get install "${APT_OPTS[@]}" \
    "$SELKIES_DEB" \
    xvfb \
    x11-xkb-utils xkb-data fontconfig fonts-dejavu-core dbus-x11 \
    socat libnspr4 libnss3 \
    xfce4 xfce4-terminal thunar mousepad ristretto \
    xubuntu-default-settings xubuntu-icon-theme xubuntu-wallpapers \
    pipewire pipewire-pulse wireplumber \
    python3-pip
} 2>&1 | tee "$LOGDIR/core.log" >/dev/null || {
  tail -60 "$LOGDIR/core.log" >&2
  exit 1
}
rm -f "$SELKIES_DEB"
log "apt + selkies + xfce + pip installed"
$SUDO apt-get autoclean

$SUDO dpkg --configure -a
$SUDO rm -f /etc/xdg/autostart/xfce4-power-manager.desktop \
  /etc/xdg/autostart/xscreensaver.desktop \
  /etc/xdg/autostart/snap-userd-autostart.desktop \
  /usr/share/xfce4/panel/plugins/power-manager-plugin.desktop
[ -x /usr/bin/exo-open ] && $SUDO mv /usr/bin/exo-open /usr/bin/exo-open-real
$SUDO install -m 755 "$UI/exo-open-wrapper" /usr/bin/exo-open
$SUDO update-alternatives --set x-session-manager /usr/bin/xfce4-session
$SUDO update-desktop-database /usr/local/share/applications || true

# isolate would stop ALL units outside graphical.target's graph — including the
# per-connection sshd@ units of any open guest shells (SIGTERM -> ssh exit 255)
$SUDO systemctl set-default graphical.target

# Wait for backgrounds we still need: chromium_dl (chromium_files reads
# /opt/cloakbrowser), extensions_dl (warm_cache bundles it), write_configs
# (selkies unit files must exist before systemctl enable --now).
wait_ok "$CB" "$LOGDIR/cb.log"
chromium_files
wait_ok "$EXT" "$LOGDIR/ext.log"
wait_ok "$CERT" "$LOGDIR/cert.log"
wait_ok "$CFG" "$LOGDIR/cfg.log"
log "selkies configs + chromium + extensions ready"
# After apt install + unit files + cert all exist: safe to start units.
# Earlier start races: xvfb binary missing → restart-loop → rate-limited fail.
enable_units

# ponytail: warm_cache is fire-and-forget; tarball may still be writing after
# the script exits. lima probe waits on selkies-tls :8080; xfce-session
# brings up the desktop. Both ready by the time the script exits.
warm_cache

log "xfce done"
touch /var/tmp/desktop.done
