#!/bin/bash

trap "printf '\nCaught ^C from user - exiting now\n' ; exit 130" INT

if [ "$(id -u)" = 0 ]; then
  SUDO=''
  export DEBIAN_FRONTEND=noninteractive
elif command -v sudo >/dev/null; then
  SUDO='sudo DEBIAN_FRONTEND=noninteractive'

  sudo -n true || sudo -v

  while true; do
    sudo -n true
    sleep 60
    kill -0 "$$" || exit
  done 2>/dev/null &
else
  printf "\nERROR: User is non-root and sudo not available, cannot proceed.\n"
  exit 1
fi

run_as() { # $SUDO is empty when we *are* root; -u would become the command
  if [ -n "$SUDO" ]; then sudo -u "$LUSER" "$@"; else runuser -u "$LUSER" -- "$@"; fi
}

FORCE=0
case "${1:-}" in
--force | -f) FORCE=1 ;;
esac

set -eu -o pipefail
# ponytail: warm-boot fast path. First successful install touches this; selkies
# units are systemctl-enabled, so systemd brings them up on boot without us.
# Saves ~10 min on every `vm up dev` after the first cold install.
[ "$FORCE" = 0 ] && [ -f /var/tmp/desktop.done ] && exit 0

LUSER=$(getent passwd | awk -F: '$6 ~ /^\/home\// {print $1; exit}')
UHOME=$(getent passwd "$LUSER" | cut -d: -f6)
LGROUP=$(getent group "$LUSER" | cut -d: -f1)
LUID=$(getent passwd "$LUSER" | cut -d: -f3)

UI=$(CDPATH='' cd -- "$(dirname -- "$0")/../ui/xfce" && pwd)
SELKIES=$(CDPATH='' cd -- "$(dirname -- "$0")/../ui/selkies" && pwd)
ARCH=$(dpkg --print-architecture)

APT_OPTS=(-y -o Acquire::Retries=3 --no-install-recommends
  -o Dpkg::Options::=--force-confdef
  -o Dpkg::Options::=--force-confold
  -o Dpkg::Options::=--force-unsafe-io
  -o "Dpkg::Path-Exclude=/usr/share/doc/*"
  -o "Dpkg::Path-Include=/usr/share/doc/*/copyright"
  -o "Dpkg::Path-Exclude=/usr/share/man/*")

log() { printf '[xfce-install] %s %s\n' "$(date +%H:%M:%S)" "$*"; }

eatmydata_setup() {
  $SUDO dpkg -i /var/cache/apt/archives/eatmydata_*.deb \
    /var/cache/apt/archives/libeatmydata1_*.deb >/dev/null 2>&1 ||
    $SUDO apt-get install "${APT_OPTS[@]}" eatmydata >/dev/null 2>&1 || true
}

wait_ok() {
  wait "$1" || {
    cat "$2" >&2
    exit 1
  }
}

selkies_deb() {
  case "$ARCH" in
  amd64) DEB=selkies-2.0.0rc0-ubuntu26.04-amd64.deb ;;
  arm64) DEB=selkies-2.0.0rc0-ubuntu26.04-arm64.deb ;;
  esac
  if [ -f "/tmp/$DEB" ]; then
    return 0
  fi
  if [ -f "/mnt/lima-provision/$DEB" ]; then
    cp "/mnt/lima-provision/$DEB" "/tmp/$DEB"
    return 0
  fi
  curl -fsSL --retry 5 --retry-all-errors -o "/tmp/$DEB" \
    "https://github.com/selkies-project/selkies/releases/download/2.0.0rc0/${DEB}"
  [ -w /mnt/lima-provision ] && cp "/tmp/$DEB" /mnt/lima-provision/ || true
}

# Latest free CloakBrowser Chromium straight from GitHub Releases. Archive
# cached on the lima-provision volume like the selkies deb, so reprovisioned
# instances skip the ~200MB download.
chromium_dl() {
  case "$ARCH" in
  amd64) CBPLAT=linux-x64 ;;
  arm64) CBPLAT=linux-arm64 ;;
  *)
    echo "unsupported arch: $ARCH" >&2
    return 1
    ;;
  esac
  local tag want
  CBV=''
  # Newest free tag that actually ships an archive for this arch; the numeric
  # grep skips -pro/-preview tags (arm64 free releases can lag x64).
  for tag in $(curl -fsSL "https://api.github.com/repos/CloakHQ/cloakbrowser/releases?per_page=30" |
    grep -oE '"tag_name": *"chromium-v[0-9.]+"' | grep -oE 'chromium-v[0-9.]+'); do
    curl -fsIL -o /dev/null \
      "https://github.com/CloakHQ/cloakbrowser/releases/download/$tag/cloakbrowser-$CBPLAT.tar.gz" &&
      CBV=$tag && break
  done
  TARBALL="cloakbrowser-$CBPLAT.tar.gz"
  CACHED="/mnt/lima-provision/cloakbrowser-$CBPLAT-$CBV.tar.gz"
  # SRC: what to extract. Cache hits read the provision volume directly —
  # no ~200MB staging copy into /tmp; only the fresh-download path stages.
  if [ -n "$CBV" ] && [ -f "$CACHED" ]; then
    SRC=$CACHED
  elif [ -n "$CBV" ]; then
    SRC="/tmp/$TARBALL"
    curl -fsSL --retry 5 --retry-all-errors -o "$SRC" \
      "https://github.com/CloakHQ/cloakbrowser/releases/download/$CBV/$TARBALL" || return 1
    want=$(curl -fsSL "https://github.com/CloakHQ/cloakbrowser/releases/download/$CBV/SHA256SUMS" |
      awk -v f="$TARBALL" '$2==f || $2=="*"f {print $1}')
    [ -n "$want" ] || return 1
    echo "$want  $SRC" | sha256sum -c - || return 1
    [ -w /mnt/lima-provision ] && cp "$SRC" "$CACHED" || true
  else
    # GitHub unreachable: newest cached archive for this arch.
    CACHED=$(find /mnt/lima-provision -maxdepth 1 -name "cloakbrowser-$CBPLAT-*.tar.gz" 2>/dev/null | sort -V | tail -1)
    [ -f "$CACHED" ] || return 1
    CBV="chromium-${CACHED##*cloakbrowser-"$CBPLAT"-}"
    CBV="${CBV%.tar.gz}"
    SRC=$CACHED
  fi
  # Extract into the final location seed_desktop expects:
  # ~/.local/share/cloakbrowser/chromium-<v>/chrome (newest wins, sort -V).
  # Flattens a single top-level dir in the archive.
  # shellcheck disable=SC2016  # runs as another user; $1..$3 expand inside, not here
  run_as bash -c '
    set -e
    d="$1/.local/share/cloakbrowser/chromium-${2#chromium-v}"
    rm -rf "$d"; mkdir -p "$d"
    tar -xzf "$3" -C "$d"
    sub=$(ls -A "$d")
    if [ "$(printf "%s\n" "$sub" | wc -l)" -eq 1 ] && [ -d "$d/$sub" ]; then
      mv "$d/$sub"/* "$d"/ && rmdir "$d/$sub"
    fi
    # prune stale versions (persistent limahome accumulates them)
    for o in "$(dirname "$d")"/chromium-*; do
      if [ -d "$o" ] && [ "$o" != "$d" ]; then rm -rf "$o"; fi
    done
    [ -x "$d/chrome" ]
  ' _ "$UHOME" "$CBV" "$SRC" && touch /tmp/cb.ok
}

# Store CRXs unpacked versionless outside the profile (GC-safe); the
# chromium-wrapper mounts them via --load-extension. Chromium will not
# accept hand-registered user extensions (Secure Preferences MACs), so
# seeding extensions.settings is pointless.
chromium_extensions() {
  $SUDO install -d -o "$LUSER" -m 755 "$UHOME/.config/chromium-extensions"
  run_as python3 "$UI/../chromium/extensions.py" \
    "$UHOME/.config/chromium-extensions" \
    "$UHOME/.config/chromium/Default/Preferences"
}

seed_desktop() {
  for _ in $(seq 1 600); do
    [ -f /tmp/cb.ok ] && break
    sleep 0.5
  done
  [ -f /tmp/cb.ok ] || return 1
  CRBIN=$($SUDO find "$UHOME/.local/share/cloakbrowser" -maxdepth 2 -name chrome -print 2>/dev/null | sort -V | tail -1)
  [ -n "$CRBIN" ]
  $SUDO install -m 644 "$UI/../chromium/99-chromium-userns.conf" /etc/sysctl.d/99-chromium-userns.conf
  $SUDO sysctl -p /etc/sysctl.d/99-chromium-userns.conf
  $SUDO install -m 755 "$UI/../chromium/chromium-wrapper" /usr/local/bin/chromium-wrapper
  for n in chrome chromium chromium-browser; do $SUDO ln -sf /usr/local/bin/chromium-wrapper /usr/local/bin/$n; done
  $SUDO install -d -m 755 /usr/local/share/applications
  $SUDO install -m 644 "$UI/../chromium/chromium-browser.desktop" /usr/local/share/applications/chromium-browser.desktop
  $SUDO chmod 755 /usr/local/share/applications
  $SUDO chmod 644 /usr/local/share/applications/chromium-browser.desktop
  # Wipe xfce caches + chromium profile before re-seeding. chromium dir
  # must be wiped here, not later — write_configs() runs in parallel and
  # used to lose the race.
  $SUDO rm -rf \
    "$UHOME/.config/xfce4" \
    "$UHOME/.config/xfce4-session" \
    "$UHOME/.config/Thunar" \
    "$UHOME/.config/autostart" \
    "$UHOME/.config/chromium" \
    "$UHOME/.cache/xfce4" \
    "$UHOME/.cache/xfce4-session" \
    "$UHOME/.cache/Thunar" \
    "$UHOME/.cache/chromium" \
    "$UHOME/.local/share/xfce4" 2>/dev/null || true
  # Seed from ui/chromium/default-profile/. Local State pins
  # profile.last_used + info_cache so chromium trusts the seed instead
  # of treating it as fresh and clobbering Preferences on first shutdown.
  # default_search_provider_data MUST live at the top level of
  # Preferences — Chromium reads it from there, not from under `search`
  # (seeding nested was the cause of "default search engine not set").
  $SUDO install -d -o "$LUSER" -m 755 "$UHOME/.config/chromium"
  $SUDO cp -r "$UI/../chromium/default-profile/Default/." \
    "$UHOME/.config/chromium/Default/"
  $SUDO install -o "$LUSER" -m 644 "$UI/../chromium/default-profile/Local State" \
    "$UHOME/.config/chromium/Local State"
  # "First Run" sentinel in the user-data-dir root: its presence makes
  # Chromium treat the profile as used, so the ungoogled-chromium welcome
  # page never appears.
  $SUDO install -o "$LUSER" -m 644 "$UI/../chromium/default-profile/First Run" \
    "$UHOME/.config/chromium/First Run"
  $SUDO chown -R "$LUSER": "$UHOME/.config/chromium"

  # Store CRXs on disk + --load-extension wrapper; user-managed (no
  # policies, no /etc, no "managed by your organization").
  chromium_extensions

  $SUDO install -d -o "$LUSER" -m 755 "$UHOME/.config"
  $SUDO cp -r "$UI/xfce4" "$UHOME/.config/xfce4"
  $SUDO chown -R "$LUSER":"$LGROUP" "$UHOME/.config/xfce4"
  $SUDO install -o "$LUSER" -m 644 "$UI/mimeapps.xfce.list" "$UHOME/.config/mimeapps.list"
  $SUDO install -d -o "$LUSER" -m 755 "$UHOME/Desktop"
  for f in chromium-browser xfce4-terminal; do
    [ -f "$UI/$f.desktop" ] &&
      $SUDO install -o "$LUSER" -m 755 "$UI/$f.desktop" \
        "$UHOME/Desktop/$f.desktop"
  done
  # gvfsd-metadata absent; Thunar honors this xattr fallback.
  run_as python3 -c "
import os
for f in ('$UHOME/Desktop/chromium-browser.desktop',
          '$UHOME/Desktop/xfce4-terminal.desktop'):
    try: os.setxattr(f, 'user.gvfs.trust', b'1')
    except OSError: pass
" 2>/dev/null || true
  # Shared home: drop launchers seeded by the MATE profile.
  $SUDO rm -f \
    "$UHOME/Desktop/mate-terminal.desktop" \
    "$UHOME/.local/share/applications/mate-terminal.desktop" 2>/dev/null || true

}

write_configs() {
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" "$SELKIES/xvfb.service" |
    $SUDO tee /etc/systemd/system/xvfb.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/xvfb.service
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" -e "s|__LUID__|$LUID|g" "$UI/xfce-session.service" |
    $SUDO tee /etc/systemd/system/xfce-session.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/xfce-session.service
  $SUDO install -d -m 755 /mnt/lima-limahome/.local/bin
  $SUDO install -m 755 "$SELKIES/selkies-session" /mnt/lima-limahome/.local/bin/selkies-session
  $SUDO install -m 755 "$SELKIES/selkies-session" /usr/local/bin/selkies-session
  # ponytail: cert existence enforced upstream by `wait_ok "$CERT"` (line ~360)
  # before this fn is awaited. Inline check here races cert_gen when both run
  # backgrounded and silently aborts write_configs → no selkies-tls.service.
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" "$SELKIES/selkies-tls.service" |
    $SUDO tee /etc/systemd/system/selkies-tls.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/selkies-tls.service
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" -e "s|__LUID__|$LUID|g" \
    "$SELKIES/selkies-autostart.service" | $SUDO tee /etc/systemd/system/selkies-autostart.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/selkies-autostart.service
  $SUDO loginctl enable-linger "$LUSER" 2>/dev/null || true
  # Chromium profile seed lives in seed_desktop() — it runs after the
  # rm -rf of $UHOME/.config/chromium, so doing the copy here would race.
}

enable_units() {
  $SUDO systemctl reset-failed xvfb xfce-session selkies-tls selkies-autostart 2>/dev/null || true
  $SUDO systemctl enable --now xvfb xfce-session selkies-tls selkies-autostart
  $SUDO systemctl daemon-reload
}

cert_gen() {
  # Both key (openssl -keyout) AND cert (cat sk.crt >>) must be present,
  # or socat OPENSSL-LISTEN rejects the file. A partial file from a prior
  # failed run still passes [ -f ], so check content too.
  if [ -s /etc/ssl/selkies.pem ] && grep -q 'BEGIN CERTIFICATE' /etc/ssl/selkies.pem 2>/dev/null; then
    return 0
  fi
  $SUDO openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -subj '/CN=localhost' \
    -keyout /etc/ssl/selkies.pem -out /tmp/sk.crt
  $SUDO sh -c 'cat /tmp/sk.crt >> /etc/ssl/selkies.pem && rm -f /tmp/sk.crt && chmod 644 /etc/ssl/selkies.pem'
}

LOGDIR=/var/log/xfce-install
$SUDO mkdir -p -m 755 "$LOGDIR"
$SUDO chown "$LUSER": "$LOGDIR"

rm -f "$LOGDIR"/*.log

exec > >(tee -a "$LOGDIR/install_linux_xfce.log") 2>&1

log 'starting install_linux_xfce'

$SUDO install -d -m 755 /var/cache/apt/archives/partial
# Skip update if install.sh preamble already updated index this boot.
{ [ -f /run/configent-apt-updated ] ||
  $SUDO apt-get update -o Acquire::Languages=none -o Acquire::Retries=3; } \
  >"$LOGDIR/apt.log" 2>&1 &
UP=$!
selkies_deb >"$LOGDIR/selkdeb.log" 2>&1 &
SDB=$!
chromium_dl >"$LOGDIR/cb.log" 2>&1 &
CB=$!
cert_gen >"$LOGDIR/cert.log" 2>&1 &
CERT=$!
write_configs >"$LOGDIR/cfg.log" 2>&1 &
CFG=$!
# ponytail: eatmydata bypasses fsync/fdatasync during apt's many commits
# (30-50% off cold installs on slow disks). Base image ships the debs in the
# apt archives cache, so dpkg -i needs no index and runs concurrently with
# apt-get update. dpkg lock is free at this point (batch starts later).
eatmydata_setup >"$LOGDIR/emd.log" 2>&1 &
EMD=$!

wait_ok "$UP" "$LOGDIR/apt.log"
log "apt index updated"
# Optional accelerator — never fatal (plain apt is the fallback).
wait "$EMD" || true
EAT='' # 'eatmydata' once preload lands; plain apt otherwise
dpkg -s eatmydata >/dev/null 2>&1 && EAT=eatmydata &&
  log "eatmydata enabled (fsync bypass → faster apt)"
# Wait for the deb download before the file check below (both bg since
# script start; usually already done).
log "waiting for selkies deb"
wait_ok "$SDB" "$LOGDIR/selkdeb.log"
SELKIES_DEB="/tmp/selkies-2.0.0rc0-ubuntu26.04-${ARCH}.deb"
[ -f "$SELKIES_DEB" ] || {
  cat "$LOGDIR/selkdeb.log" >&2
  exit 1
}

# seed_desktop self-waits on /tmp/cb.ok (chromium_dl) and touches no apt
# packages (python3 is in the base image; browser alternatives moved below
# to avoid interleaving with apt's own update-alternatives calls) — so it
# runs concurrently with the apt batch instead of after it.
seed_desktop >"$LOGDIR/seed.log" 2>&1 &
SEED=$!

log "apt + selkies + xfce install starting (single batch)"
{
  $SUDO $EAT apt-get install "${APT_OPTS[@]}" \
    "$SELKIES_DEB" \
    xvfb \
    x11-xkb-utils xkb-data fontconfig dbus-x11 \
    xsel \
    socat libnspr4 libnss3 \
    xfce4 xfce4-terminal thunar mousepad ristretto \
    xubuntu-default-settings xubuntu-icon-theme xubuntu-wallpapers \
    pavucontrol \
    pipewire pipewire-pulse wireplumber \
    unzip
} 2>&1 | tee "$LOGDIR/core.log" >/dev/null || {
  tail -60 "$LOGDIR/core.log" >&2
  exit 1
}
rm -f "$SELKIES_DEB"
log "apt + selkies + xfce installed"
$SUDO rm -f /etc/xdg/autostart/xfce4-power-manager.desktop \
  /etc/xdg/autostart/xscreensaver.desktop \
  /etc/xdg/autostart/snap-userd-autostart.desktop \
  /usr/share/xfce4/panel/plugins/power-manager-plugin.desktop
[ -x /usr/bin/exo-open ] && $SUDO mv /usr/bin/exo-open /usr/bin/exo-open-real
$SUDO install -m 755 "$UI/exo-open-wrapper" /usr/bin/exo-open
$SUDO update-alternatives --set x-session-manager /usr/bin/xfce4-session
update-desktop-database /usr/local/share/applications 2>/dev/null || true

# isolate would stop ALL units outside graphical.target's graph — including the
# per-connection sshd@ units of any open guest shells (SIGTERM -> ssh exit 255)
$SUDO systemctl set-default graphical.target

# Wait for backgrounds we still need: chromium_dl (seed_desktop reads
# ~/.local/share/cloakbrowser), write_configs (selkies unit files must exist
# before systemctl enable --now).
wait_ok "$CB" "$LOGDIR/cb.log"
wait_ok "$SEED" "$LOGDIR/seed.log"
wait_ok "$CERT" "$LOGDIR/cert.log"
wait_ok "$CFG" "$LOGDIR/cfg.log"
log "selkies configs + chromium ready"
# Register + select chromium-wrapper as the system default browser. Must
# run AFTER wait_ok SEED: seed_desktop installs the wrapper (line ~173), and
# registering a nonexistent path makes update-alternatives exit nonzero,
# which under set -e killed the script before enable_units → no units enabled.
$SUDO update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/local/bin/chromium-wrapper 200
$SUDO update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser /usr/local/bin/chromium-wrapper 200
$SUDO update-alternatives --set x-www-browser /usr/local/bin/chromium-wrapper
$SUDO update-alternatives --set gnome-www-browser /usr/local/bin/chromium-wrapper
$SUDO update-desktop-database /usr/local/share/applications || true
# After apt install + unit files + cert all exist: safe to start units.
# Earlier start races: xvfb binary missing → restart-loop → rate-limited fail.
enable_units

log "xfce done"
touch /var/tmp/desktop.done
