#!/bin/bash

trap "printf '\nCaught ^C from user - exiting now\n' ; exit 130" INT

if [ "$(uname -s)" != "Linux" ]; then
  printf 'ERROR: install_linux_apps must be run on Linux.\n' >&2
  exit 1
fi

if [ "$(id -u)" = 0 ]; then
  SUDO=''
  export DEBIAN_FRONTEND=noninteractive
elif command -v sudo >/dev/null; then
  SUDO='sudo DEBIAN_FRONTEND=noninteractive'

  sudo -n true || sudo -v

  while true; do
    sudo -n true
    sleep 60
    kill -0 "$$" || exit
  done 2>/dev/null &
else
  printf "\nERROR: User is non-root and sudo not available, cannot proceed.\n"
  exit 1
fi

run_as() { # $SUDO is empty when we *are* root; -u would become the command
  if [ -n "$SUDO" ]; then sudo -u "$LUSER" "$@"; else runuser -u "$LUSER" -- "$@"; fi
}

set -eu -o pipefail

LUSER=$(getent passwd | awk -F: '$6 ~ /^\/home\// {print $1; exit}')
UHOME=$(getent passwd "$LUSER" | cut -d: -f6)
LGROUP=$(getent group "$LUSER" | cut -d: -f1)
ARCH=$(dpkg --print-architecture)
LINUX=$(CDPATH='' cd -- "$(dirname -- "$0")/../linux" && pwd)

log() { printf '[linux-apps] %s %s\n' "$(date +%H:%M:%S)" "$*"; }

APT_OPTS=(-y -o Acquire::Retries=3 --no-install-recommends
  -o Dpkg::Options::=--force-confdef
  -o Dpkg::Options::=--force-confold
  -o Dpkg::Options::=--force-unsafe-io
  -o "Dpkg::Path-Exclude=/usr/share/doc/*"
  -o "Dpkg::Path-Include=/usr/share/doc/*/copyright"
  -o "Dpkg::Path-Exclude=/usr/share/man/*")

# same eatmydata wrap as the other apt scripts: skips fsyncs during the
# ~1.4GB deb unpack. Desktop script installs eatmydata, and this runs
# after wait_batch, so it is present.
EAT=()
command -v eatmydata >/dev/null 2>&1 && EAT+=(eatmydata)

# Official VSCode (packages.microsoft.com) + Brave (brave-browser-apt-
# release.s3.brave.com) apt repos. Both ship amd64+arm64. Keys stored as
# downloaded (Brave: binary keyring, MS: armored .asc — apt >= 2.4 accepts
# armored signed-by, no gpg needed). Debs cache on the provision volume
# like the selkies deb: reprovisions install the cached deb and skip
# the ~250MB download; the repo version only wins when nothing is cached.
extra_repos() {
  PKGS=()
  case "$ARCH" in
  amd64 | arm64) ;;
  *)
    log "unsupported arch: $ARCH, skipping"
    return 0
    ;;
  esac
  $SUDO install -d -m 755 /usr/share/keyrings
  # fetch both keys concurrently — saves a round-trip
  local tmpd
  tmpd=$(mktemp -d)
  curl -fsSL --retry 5 --retry-all-errors \
    https://packages.microsoft.com/keys/microsoft.asc -o "$tmpd/microsoft.asc" &
  local pid1=$!
  curl -fsSL --retry 5 --retry-all-errors \
    https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg \
    -o "$tmpd/brave-browser-archive-keyring.gpg" &
  local pid2=$!
  wait "$pid1" && [ -s "$tmpd/microsoft.asc" ] &&
    $SUDO install -m 644 "$tmpd/microsoft.asc" /usr/share/keyrings/microsoft.asc &&
    printf 'deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/microsoft.asc] https://packages.microsoft.com/repos/code stable main\n' |
    $SUDO tee /etc/apt/sources.list.d/vscode.list >/dev/null || true
  wait "$pid2" && [ -s "$tmpd/brave-browser-archive-keyring.gpg" ] &&
    $SUDO install -m 644 "$tmpd/brave-browser-archive-keyring.gpg" \
      /usr/share/keyrings/brave-browser-archive-keyring.gpg &&
    printf 'deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main\n' |
    $SUDO tee /etc/apt/sources.list.d/brave-browser-release.list >/dev/null || true
  rm -rf "$tmpd"
  # cached deb on the provision volume beats the repo; repo name only
  # when its sources+key landed (this run or persisted on the VM disk).
  # brave-keyring: cached-deb only (arch all) — kills the first-boot
  # apt-get update fallback; when absent, the repo dep path pulls it.
  local p f
  for p in code brave-browser brave-keyring; do
    f=$(find /mnt/lima-provision -maxdepth 1 -name "${p}_*_*.deb" 2>/dev/null |
      sort -V | tail -1)
    if [ -n "$f" ]; then
      PKGS+=("$f")
    elif [ "$p" = code ] && [ -s /usr/share/keyrings/microsoft.asc ] &&
      [ -f /etc/apt/sources.list.d/vscode.list ]; then
      PKGS+=(code)
    elif [ "$p" = brave-browser ] && [ -s /usr/share/keyrings/brave-browser-archive-keyring.gpg ] &&
      [ -f /etc/apt/sources.list.d/brave-browser-release.list ]; then
      PKGS+=(brave-browser)
    else
      log "no repo and no cached deb for $p, skipping"
    fi
  done
}

# deb-shipped launchers → Desktop + menu, and Brave takes over as default
# browser in ~/.config/mimeapps.list (seeded chromium by the desktop script).
launchers() {
  local installed=()
  dpkg -s code >/dev/null 2>&1 && installed+=(com.microsoft.VSCode)
  dpkg -s brave-browser >/dev/null 2>&1 && installed+=(brave-browser)
  [ "${#installed[@]}" -gt 0 ] || return 0
  $SUDO install -d -o "$LUSER" -g "$LGROUP" -m 755 \
    "$UHOME/Desktop" "$UHOME/.local/share/applications"
  local f
  for f in "${installed[@]}"; do
    [ -f "/usr/share/applications/$f.desktop" ] || continue
    $SUDO install -o "$LUSER" -g "$LGROUP" -m 755 "/usr/share/applications/$f.desktop" \
      "$UHOME/Desktop/$f.desktop"
    $SUDO install -o "$LUSER" -g "$LGROUP" -m 644 "/usr/share/applications/$f.desktop" \
      "$UHOME/.local/share/applications/$f.desktop"
  done
  if dpkg -s brave-browser >/dev/null 2>&1; then
    # Seed from linux/brave/. Same logic as the chromium seed in
    # install_linux_xfce: Local State pins profile.last_used +
    # info_cache so Brave trusts the seed instead of treating it as
    # fresh and clobbering Preferences on first shutdown; "First Run"
    # sentinel in the user-data-dir root suppresses the welcome flow.
    # Preferences is cleaned: no mac accelerators, GUIDs, telemetry
    # counters, session logs.
    $SUDO install -d -o "$LUSER" -g "$LGROUP" -m 755 \
      "$UHOME/.config/BraveSoftware/Brave-Browser/Default"
    $SUDO cp -r "$LINUX/brave/Default/." \
      "$UHOME/.config/BraveSoftware/Brave-Browser/Default/"
    $SUDO install -o "$LUSER" -g "$LGROUP" -m 644 \
      "$LINUX/brave/Local State" \
      "$UHOME/.config/BraveSoftware/Brave-Browser/Local State"
    $SUDO install -o "$LUSER" -g "$LGROUP" -m 644 \
      "$LINUX/brave/First Run" \
      "$UHOME/.config/BraveSoftware/Brave-Browser/First Run"
    $SUDO chown -R "$LUSER":"$LGROUP" \
      "$UHOME/.config/BraveSoftware"
    # Store CRXs + --load-extension wrapper — same approach as chromium in
    # install_linux_xfce (Brave refuses hand-registered user extensions,
    # so seeding extensions.settings is pointless). Tolerate offline:
    # wrapper's --load-extension dirs just warn if absent.
    $SUDO install -d -o "$LUSER" -g "$LGROUP" -m 755 \
      "$UHOME/.config/brave-extensions"
    run_as python3 "$LINUX/brave/extensions.py" \
      "$UHOME/.config/brave-extensions" \
      "$UHOME/.config/BraveSoftware/Brave-Browser/Default/Preferences" ||
      log "brave extension fetch failed (offline?)"
    $SUDO install -d -o "$LUSER" -g "$LGROUP" -m 755 "$UHOME/.local/bin"
    $SUDO install -o "$LUSER" -g "$LGROUP" -m 755 \
      "$LINUX/brave/brave-wrapper" "$UHOME/.local/bin/brave-wrapper"
    $SUDO install -o "$LUSER" -g "$LGROUP" -m 755 \
      "$LINUX/chromium/chromium-wrapper" "$UHOME/.local/bin/chromium-wrapper"
    # Desktop + menu launchers Exec-rewritten to the wrapper (desktop
    # files don't expand $HOME) — deb file has Exec=/usr/bin/brave-browser-stable.
    sed "s|/usr/bin/brave-browser-stable|$UHOME/.local/bin/brave-wrapper|g" \
      /usr/share/applications/brave-browser.desktop |
      $SUDO tee "$UHOME/.local/share/applications/brave-browser.desktop" >/dev/null
    $SUDO chown "$LUSER":"$LGROUP" \
      "$UHOME/.local/share/applications/brave-browser.desktop"
    $SUDO install -o "$LUSER" -g "$LGROUP" -m 755 \
      "$UHOME/.local/share/applications/brave-browser.desktop" \
      "$UHOME/Desktop/brave-browser.desktop"
    if [ -f "$UHOME/.config/mimeapps.list" ]; then
      $SUDO sed -i 's/chromium-browser\.desktop/brave-browser.desktop/g' \
        "$UHOME/.config/mimeapps.list"
      $SUDO chown "$LUSER":"$LGROUP" "$UHOME/.config/mimeapps.list"
    fi
    # xfce helpers.rc WebBrowser overrides mimeapps.list for XFCE apps
    # and xdg-settings under an xfce session. Value must be an exo helper
    # basename in /usr/share/xfce4/helpers/. Alias brave.desktop →
    # brave-browser.desktop so xdg-settings get default-web-browser returns
    # brave-browser.desktop — what Brave's self-check compares against;
    # otherwise Brave reports "cannot determine or set the default browser".
    if [ -f /usr/share/xfce4/helpers/brave.desktop ] &&
      [ ! -f /usr/share/xfce4/helpers/brave-browser.desktop ]; then
      $SUDO cp /usr/share/xfce4/helpers/brave.desktop \
        /usr/share/xfce4/helpers/brave-browser.desktop
      # %B would resolve to /usr/bin/brave (raw binary, no wrapper flags);
      # point helper resolution at brave-wrapper in ~/.local/bin instead.
      $SUDO sed -i 's/^X-XFCE-Binaries=.*/X-XFCE-Binaries=brave-wrapper;/' \
        /usr/share/xfce4/helpers/brave-browser.desktop
    fi
    for f in "$UHOME/.config/xfce4/helpers.rc" /etc/xdg/xfce4/helpers.rc; do
      if [ -f "$f" ]; then
        $SUDO sed -i 's/^WebBrowser=.*/WebBrowser=brave-browser/' "$f"
        $SUDO sed -i 's/^TerminalEmulator=.*/TerminalEmulator=xfce4-terminal/' "$f"
      fi
    done
    $SUDO chown "$LUSER":"$LGROUP" "$UHOME/.config/xfce4/helpers.rc" 2>/dev/null || true
    # WebBrowser launches are forced to Brave by linux/xfce/exo-open-wrapper
    # (installed by install_linux_xfce) — installs run before Brave exists.
    # The XFCE chooser dialog resolves X-XFCE-Binaries via g_find_program_in_path
    # at click time; if brave-wrapper is only in ~/.local/bin and the xfce session
    # PATH dropped it, lookup returns NULL → "No helper defined" despite
    # helpers.rc being correct. Symlink into /usr/local/bin so it always resolves.
    if [ -x "$UHOME/.local/bin/brave-wrapper" ] && [ ! -e /usr/local/bin/brave-wrapper ]; then
      $SUDO ln -sf "$UHOME/.local/bin/brave-wrapper" /usr/local/bin/brave-wrapper
    fi
    if [ -x "$UHOME/.local/bin/chromium-wrapper" ] && [ ! -e /usr/local/bin/chromium-wrapper ]; then
      $SUDO ln -sf "$UHOME/.local/bin/chromium-wrapper" /usr/local/bin/chromium-wrapper
    fi
  fi
  # gvfsd-metadata may be absent; Caja/Thunar honor this xattr fallback.
  run_as python3 -c "
import os
for f in ('$UHOME/Desktop/brave-browser.desktop',
          '$UHOME/Desktop/com.microsoft.VSCode.desktop'):
    try: os.setxattr(f, 'user.gvfs.trust', b'1')
    except OSError: pass
" 2>/dev/null || true
  run_as update-desktop-database "$UHOME/.local/share/applications" 2>/dev/null || true
}

# pass-secret-service: Secret Service API (org.freedesktop.secrets) backed
# by pass for libsecret clients (Brave passwords, VSCode). Upstream units
# from https://github.com/grimsteel/pass-secret-service/tree/main/systemd,
# Exec adapted to /usr/local/bin where the bare prebuilt binary is dropped
# (pure-rust dbus, no runtime deps). Runs before the early-exit below so
# reprovisions re-assert the config. No gnome-keyring involvement: nothing
# installs it, and the org.freedesktop.secrets claim is user-local
# (~/.local/share/dbus-1/services), so it only exists for this user.
secret_service() {
  command -v pass >/dev/null 2>&1 ||
    {
      log "pass not present, skipping secret service"
      return 0
    }
  local arch
  case "$ARCH" in
  amd64) arch=x86_64 ;;
  arm64) arch=aarch64 ;;
  *)
    log "no pass-secret-service build for $ARCH, skipping"
    return 0
    ;;
  esac
  local bin=/usr/local/bin/pass-secret-service
  if [ ! -x "$bin" ]; then
    local ver=v0.7.1
    local url="https://github.com/grimsteel/pass-secret-service/releases/download/$ver/pass-secret-service-$arch"
    local cached="/mnt/lima-provision/pass-secret-service-$arch" tmp
    if [ -s "$cached" ]; then
      $SUDO install -m 755 "$cached" "$bin"
    else
      tmp=$(mktemp)
      curl -fsSL --retry 5 --retry-all-errors -o "$tmp" "$url"
      $SUDO install -m 755 "$tmp" "$bin"
      $SUDO cp "$tmp" /mnt/lima-provision/ 2>/dev/null || true
      rm -f "$tmp"
    fi
  fi
  # user-scope claim only: session bus resolves org.freedesktop.secrets
  # from ~/.local/share/dbus-1/services; no system-wide file needed
  $SUDO install -d -o "$LUSER" -g "$LGROUP" -m 755 \
    "$UHOME/.config/systemd/user" "$UHOME/.local/share/dbus-1/services"
  $SUDO install -o "$LUSER" -g "$LGROUP" -m 644 \
    "$LINUX/secret/org.freedesktop.secrets.service" \
    "$UHOME/.local/share/dbus-1/services/"
  $SUDO install -o "$LUSER" -g "$LGROUP" -m 644 \
    "$LINUX/secret/pass-secret-service.service" \
    "$UHOME/.config/systemd/user/"
  # idle store: empty-passphrase batch key, same identity bin/secret uses —
  # the service reads the store lazily, but init here keeps first unlock simple
  if ! run_as test -s "$UHOME/.password-store/.gpg-id"; then
    # shellcheck disable=SC2016  # $ must stay literal: runs as $LUSER
    run_as bash -c 'set -e
      gpg --batch --pinentry-mode loopback --passphrase "" \
        --quick-gen-key "Password Store <password-store@localhost>" \
        default default never 2>/dev/null || true
      gpg_id=$(gpg --with-colons --list-secret-keys 2>/dev/null |
        grep "^fpr:" | head -1 | cut -d: -f10)
      [ -n "$gpg_id" ] && pass init "$gpg_id"' ||
      log "pass store init deferred (bin/secret initializes on first use)"
  fi
  log "pass-secret-service ready (dbus-activatable org.freedesktop.secrets)"

  # VS Code must target libsecret explicitly: its auto-detect pops
  # "An OS keyring could not be identified" on this setup. argv.json is
  # JSONC and only exists after first launch; preserve it if present.
  run_as python3 - "$UHOME/.vscode/argv.json" <<'PY'
import json, os, re, sys
p = sys.argv[1]
os.makedirs(os.path.dirname(p), exist_ok=True)
s = open(p).read() if os.path.exists(p) else ''
s = re.sub(r'//[^\n]*', '', s)
d = json.loads(s) if s.strip() else {}
d.setdefault('password-store', 'gnome-libsecret')
open(p, 'w').write(json.dumps(d, indent=1) + '\n')
PY
}

# cua-driver (https://cua.ai, trycua/cua): computer-use automation driver.
# Installs the latest cua-driver-rs release user-local, mirroring the
# official installer layout (~/.cua-driver/packages/releases/<ver>-<triple>/,
# relative `current` pointer, ~/.local/bin/cua-driver symlink). Release tag
# resolves via the GitHub API with a /mnt/lima-provision tarball cache as
# offline fallback; fresh downloads verify against the release SHA256SUMS.
#
# The daemon binds ~/.cache/cua-driver/cua-driver.sock, but Lima homes are
# virtiofs mounts from macOS and virtiofs cannot host AF_UNIX sockets
# (bind → "Operation not supported", os error 95). When ~/.cache sits on
# such a filesystem the socket dir is relocated to native /var/cache and
# symlinked back, so serve/mcp/stop/status keep their default paths.
# A systemd --user unit (mirroring upstream libs/cua-driver installers'
# --autostart recipe) + linger keeps the serve daemon running across boots
# of headless VMs where the user never logs in interactively.
# Runs before the early-exit below so reprovisions re-assert everything.
cua_driver() {
  local triple
  case "$ARCH" in
  amd64) triple=x86_64-unknown-linux-gnu ;;
  arm64) triple=aarch64-unknown-linux-gnu ;;
  *)
    log "no cua-driver build for $ARCH, skipping"
    return 0
    ;;
  esac

  # latest cua-driver-rs tag (the repo ships other release trains too)
  local tag ver cur=""
  tag=$(curl -fsSL --retry 5 --retry-all-errors \
    "https://api.github.com/repos/trycua/cua/releases?per_page=100" |
    grep -o '"tag_name": *"cua-driver-rs-v[0-9.]*"' |
    sed 's/.*v//; s/"$//' | sort -V | tail -1 || true)
  if [ -z "$tag" ]; then
    # offline or API rate-limited: newest cached tarball wins
    ver=$(
      find /mnt/lima-provision -maxdepth 1 -name 'cua-driver-rs-*-linux-*' -printf '%f\n' 2>/dev/null |
        sed -n 's/^cua-driver-rs-\([0-9][0-9.]*\)-linux-.*/\1/p' |
        sort -V | tail -1
    )
    [ -n "$ver" ] && log "cua-driver release lookup failed, using cache $ver"
  else
    ver=${tag#cua-driver-rs-v}
  fi
  [ -x "$UHOME/.local/bin/cua-driver" ] &&
    cur=$("$UHOME/.local/bin/cua-driver" --version 2>/dev/null | awk '{print $2}')

  if [ -n "$ver" ] && [ "$cur" != "$ver" ]; then
    local asset="cua-driver-rs-$ver-linux-$ARCH-binary.tar.gz"
    local cached="/mnt/lima-provision/$asset" expected t rel
    t=$(mktemp -d)
    if [ -s "$cached" ]; then
      cp "$cached" "$t/$asset"
    else
      local base="https://github.com/trycua/cua/releases/download/cua-driver-rs-v$ver"
      curl -fsSL --retry 5 --retry-all-errors -o "$t/$asset" "$base/$asset"
      curl -fsSL --retry 5 --retry-all-errors -o "$t/SHA256SUMS" "$base/SHA256SUMS"
      expected=$(awk -v a="$asset" '$2 == a {print $1}' "$t/SHA256SUMS")
      if [ -z "$expected" ] ||
        [ "$(sha256sum "$t/$asset" | awk '{print $1}')" != "$expected" ]; then
        log "$asset checksum mismatch, aborting cua-driver install"
        rm -rf "$t"
        return 0
      fi
      $SUDO cp "$t/$asset" /mnt/lima-provision/ 2>/dev/null || true
    fi
    # stop any running daemon before swapping binaries (installer behaviour)
    run_as "$UHOME/.local/bin/cua-driver" stop >/dev/null 2>&1 || true
    mkdir "$t/x"
    tar -xzf "$t/$asset" -C "$t/x"
    rel="$UHOME/.cua-driver/packages/releases/$ver-$triple"
    $SUDO rm -rf "$rel"
    $SUDO install -d -o "$LUSER" -g "$LGROUP" -m 755 \
      "$UHOME/.cua-driver/packages/releases" "$rel" "$UHOME/.local/bin"
    $SUDO cp -a "$t/x"/. "$rel"/
    $SUDO chown -R "$LUSER":"$LGROUP" "$rel"
    $SUDO chmod 755 "$rel/cua-driver"
    $SUDO ln -sfn "releases/$ver-$triple" "$UHOME/.cua-driver/packages/current"
    run_as ln -sfn "$UHOME/.cua-driver/packages/current/cua-driver" \
      "$UHOME/.local/bin/cua-driver"
    log "cua-driver $ver installed"
    rm -rf "$t"
  elif [ -n "$cur" ]; then
    log "cua-driver $cur already installed"
  fi
  [ -x "$UHOME/.local/bin/cua-driver" ] || return 0

  # relocate the socket dir off AF_UNIX-incapable mounts (Lima virtiofs)
  local sockdir="$UHOME/.cache/cua-driver" fs
  if [ -L "$sockdir" ] && [ ! -d "$sockdir/" ]; then
    # dangling symlink: /var/cache/cua-driver was wiped — recreate it
    $SUDO install -d -o "$LUSER" -g "$LGROUP" -m 755 /var/cache/cua-driver
    log "cua-driver socket dir /var/cache/cua-driver recreated (was missing)"
  fi
  if [ ! -L "$sockdir" ]; then
    fs=$(stat -f -c %T "$UHOME/.cache" 2>/dev/null || echo unknown)
    case "$fs" in
    # stat reports ext4 as "ext2/ext3"
    ext2/ext3 | xfs | btrfs | zfs | tmpfs | overlay | squashfs | unknown) ;;
    *)
      # virtiofs/fuseblk/9p/nfs/cifs: bind() would fail (os error 95)
      $SUDO install -d -o "$LUSER" -g "$LGROUP" -m 755 /var/cache/cua-driver
      run_as "$UHOME/.local/bin/cua-driver" stop >/dev/null 2>&1 || true
      $SUDO rm -rf "$sockdir"
      run_as ln -s /var/cache/cua-driver "$sockdir"
      log "cua-driver socket dir → /var/cache/cua-driver ($fs cannot host unix sockets)"
      ;;
    esac
  fi

  # daemon autostart: systemd --user unit, same recipe as upstream
  # trycua/cua installers register with --autostart. Unit file lives in
  # linux/cua-driver/; %h in ExecStart resolves to the user's home.
  if command -v systemctl >/dev/null 2>&1; then
    local unit_dir="$UHOME/.config/systemd/user"
    run_as mkdir -p "$unit_dir"
    $SUDO install -o "$LUSER" -g "$LGROUP" -m 644 \
      "$LINUX/cua-driver/cua-driver.service" "$unit_dir/"
    # linger starts the user manager at boot on headless VMs; the daemon
    # then starts via default.target without any interactive login
    $SUDO loginctl enable-linger "$LUSER" 2>/dev/null || true
    local i=0
    while [ $i -lt 10 ] &&
      ! run_as env "XDG_RUNTIME_DIR=/run/user/$(id -u "$LUSER")" systemctl --user is-system-running >/dev/null 2>&1; do
      sleep 1
      i=$((i + 1))
    done
    run_as env "XDG_RUNTIME_DIR=/run/user/$(id -u "$LUSER")" systemctl --user daemon-reload || true
    if run_as env "XDG_RUNTIME_DIR=/run/user/$(id -u "$LUSER")" systemctl --user enable --now cua-driver.service; then
      log "cua-driver daemon autostart enabled"
    else
      log "warn: could not enable cua-driver systemd user unit"
    fi
  fi
}

secret_service
cua_driver

if dpkg -s code >/dev/null 2>&1 && dpkg -s brave-browser >/dev/null 2>&1; then
  log "code + brave-browser already installed"
  launchers
  exit 0
fi

extra_repos
log "installing: ${PKGS[*]:-none}"

[ "${#PKGS[@]}" -gt 0 ] || {
  launchers
  exit 0
}

# apt index is only needed when installing from a repo. Cached local debs
# resolve their deps against the distro index the desktop script already
# refreshed this boot. If deps are somehow missing, the retry below updates
# and tries again.
all_cached=true
for p in "${PKGS[@]}"; do
  [ "${p:0:1}" = '/' ] || all_cached=false
done

if [ "$all_cached" = false ]; then
  $SUDO apt-get update -o Acquire::Languages=none -o Acquire::Retries=3
  $SUDO "${EAT[@]}" apt-get install "${APT_OPTS[@]}" "${PKGS[@]}"
else
  $SUDO "${EAT[@]}" apt-get install "${APT_OPTS[@]}" "${PKGS[@]}" || {
    log "dep resolution failed, updating index and retrying"
    $SUDO apt-get update -o Acquire::Languages=none -o Acquire::Retries=3
    $SUDO "${EAT[@]}" apt-get install "${APT_OPTS[@]}" "${PKGS[@]}"
  }
fi

# cache debs on the provision volume (selkies-deb pattern); skip the
# ~250MB copy when the exact same deb is already there
for p in code brave-browser brave-keyring; do
  f=$(find /var/cache/apt/archives -maxdepth 1 -name "${p}_*_*.deb" 2>/dev/null | sort -V | tail -1)
  [ -n "$f" ] || continue
  b=${f##*/}
  if [ -f "/mnt/lima-provision/$b" ] &&
    [ "$(stat -c%s "$f")" = "$(stat -c%s "/mnt/lima-provision/$b" 2>/dev/null)" ]; then
    continue
  fi
  $SUDO cp "$f" "/mnt/lima-provision/" 2>/dev/null || true
done

launchers
log "done"
