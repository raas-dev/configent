#!/bin/sh

# configent (https://github.com/raas-dev/configent)
# One command automated macOS/Linux laptop/VM/container bootstrapper.
#
# Copyright(C) 2016- Anssi Syrjäsalo (http://a.syrjasalo.com)
# Licensed under GNU Lesser General Public License v3 (LGPL-3.0).

### constants ##################################################################

this_path=$(cd "$(dirname "$0")" && pwd)
backup_path="$this_path/../.backup"
config_path="$HOME/.config/configent"

### configs ####################################################################

# config.toml
if [ ! -r "$backup_path/.config/herdr/config.toml" ]; then
  if [ -r "$HOME/.config/herdr/config.toml" ]; then
    mkdir -p "$backup_path/.config/herdr"
    cp -P "$HOME/.config/herdr/config.toml" \
      "$backup_path/.config/herdr/config.toml"
  fi
fi
mkdir -p "$HOME/.config/herdr"
ln -sfnv "$config_path/herdr/config.toml" "$HOME/.config/herdr/config.toml"

# plugins/config dir
if [ ! -r "$backup_path/.config/herdr/plugins/config" ]; then
  if [ -r "$HOME/.config/herdr/plugins/config" ]; then
    mkdir -p "$backup_path/.config/herdr/plugins"
    cp -RP "$HOME/.config/herdr/plugins/config" \
      "$backup_path/.config/herdr/plugins/config"
  fi
fi
mkdir -p "$HOME/.config/herdr/plugins"
rm -rf "$HOME/.config/herdr/plugins/config"
ln -sfnv "$config_path/herdr/plugins/config" \
  "$HOME/.config/herdr/plugins/config"

### herdr-nvim ###############################################################

# hosts.toml
if [ ! -r "$backup_path/.config/herdr-nvim/config.toml" ]; then
  if [ -r "$HOME/.config/herdr-nvim/config.toml" ]; then
    mkdir -p "$backup_path/.config/herdr-nvim"
    cp -P "$HOME/.config/herdr-nvim/config.toml" \
      "$backup_path/.config/herdr-nvim/config.toml"
  fi
fi
mkdir -p "$HOME/.config/herdr-nvim"
ln -sfnv "$config_path/herdr/plugins/config/chmarax.herdr-nvim/config.toml" \
  "$HOME/.config/herdr-nvim/config.toml"

### herdr-projects #############################################################

# symlink the whole settings dir, not the file: herdr-projects rewrites
# config.json atomically (temp file + rename), which would replace a
# file-level symlink with a regular file
if [ ! -L "$HOME/.herdr-projects/settings" ]; then
  rm -rf "$HOME/.herdr-projects/settings"
fi
ln -sfnv "$config_path/herdr/plugins/config/herdr-projects" \
  "$HOME/.herdr-projects/settings"

### plugins ####################################################################

if command -v herdr >/dev/null; then
  herdr plugin install alvinunreal/oh-my-opencode-slim --yes
  herdr plugin install ChmaraX/herdr-nvim --yes
  herdr plugin install devswha/ovis --yes
  herdr plugin install eliasstravik/herdr-projects --yes
  herdr plugin install jeffarese/herdr-bar --yes
  herdr plugin install jhochenbaum/herdr-hunk-diff --yes
  herdr server reload-config || true
fi
