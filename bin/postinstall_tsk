### constants ##################################################################

this_path=$(cd "$(dirname "$0")" && pwd)
backup_path="$this_path/../.backup"
config_path="$HOME/.config/configent"

### configs ####################################################################

# config.toml
if [ ! -r "$backup_path/.tsk/config.toml" ]; then
  if [ -r "$HOME/.tsk/config.toml" ] && [ ! -L "$HOME/.tsk/config.toml" ]; then
    mkdir -p "$backup_path/.tsk"
    cp -P "$HOME/.tsk/config.toml" "$backup_path/.tsk/config.toml"
  fi
fi

mkdir -p "$HOME/.tsk"
ln -sfnv "$config_path/tsk/config.toml" "$HOME/.tsk/config.toml"
