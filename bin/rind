#!/usr/bin/env bash

# configent (https://github.com/raas-dev/configent)
# rind: build and run current directory in Docker.
#
# Copyright(C) 2016- Anssi Syrjäsalo (http://a.syrjasalo.com)
# Licensed under GNU Lesser General Public License v3 (LGPL-3.0).

# lowercase the image name to allow pushing it to container registries
prog="${0##*/}"
name="$(echo "${PWD##*/}" | tr '[:upper:]' '[:lower:]')"

if docker top "$name" >/dev/null 2>&1; then
  docker stop "$name" || docker kill "$name"
fi

if [ -r "$PWD/Dockerfile" ]; then
  echo "[$prog] Building image from Dockerfile"
  docker build --pull --tag "$name" . || exit
else
  echo "[$prog] Building image with railpack"
  if ! docker top buildkit >/dev/null 2>&1; then
    docker run --rm --privileged -d --name buildkit moby/buildkit >/dev/null || exit
  fi
  BUILDKIT_HOST='docker-container://buildkit' \
    railpack build . --name "$name" || exit
fi

if [ -n "$PORT" ]; then
  port_args=""
  first_port=""

  # Split PORT by comma and create publish args for each
  remaining_ports="$PORT"
  while [ -n "$remaining_ports" ]; do
    if [ "$remaining_ports" != "${remaining_ports#*,}" ]; then
      # Contains comma, extract first port
      port="${remaining_ports%%,*}"
      remaining_ports="${remaining_ports#*,}"
    else
      # No more commas, this is the last port
      port="$remaining_ports"
      remaining_ports=""
    fi

    # Trim whitespace and skip empty ports
    port=$(echo "$port" | xargs)
    if [ -n "$port" ]; then
      port_args="$port_args --publish 127.0.0.1:$port:$port"
      # Use first valid port as the main PORT env var for the container
      if [ -z "$first_port" ]; then
        first_port="$port"
      fi
    fi
  done

  # Pass only the first port as PORT env var to the container
  env_args="--env PORT=$first_port"

  # Debug: show what we're setting
  echo "[$prog] Port mappings: $port_args"
  echo "[$prog] Container PORT env: $first_port"
fi

[ -r "$PWD/.env" ] && env_file="--env-file $PWD/.env"

if [ -n "$1" ] && [ "$1" != "-d" ] && [ "$1" != "--detach" ]; then
  # shellcheck disable=SC2086  # port_args/env_file/env_args are word-split args lists
  docker run --init -it --name "$name" --rm \
    --cap-drop ALL \
    $port_args \
    $env_file \
    $env_args \
    --log-driver none --entrypoint /bin/sh \
    "$name" -c "$*"
  run_exit_code=$?
else
  # shellcheck disable=SC2086  # port_args/env_file/env_args are word-split args lists
  docker run --init -it --name "$name" --rm \
    --cap-drop ALL \
    $port_args \
    $env_file \
    $env_args \
    "$@" "$name"
  run_exit_code=$?

  if [ "$1" = "-d" ] || [ "$1" = "--detach" ]; then
    echo "[$prog] Published ports: container -> host"
    docker port "$name"
    echo "[$prog] Following logs, ^C does not halt the container"
    docker logs --follow "$name"
  fi
fi

exit $run_exit_code
