### constants ##################################################################

this_path=$(cd "$(dirname "$0")" && pwd)
backup_path="$this_path/../.backup"
config_path="$HOME/.config/configent"

### configs ####################################################################

# backup
if [ ! -r "$backup_path/.plannotator/config.json" ]; then
  if [ -r "$HOME/.plannotator/config.json" ]; then
    mkdir -p "$backup_path/.plannotator"
    cp -P "$HOME/.plannotator/config.json" \
      "$backup_path/.plannotator/config.json"
  fi
fi

# symlink
mkdir -p "$HOME/.plannotator"
ln -sfnv "$config_path/plannotator/config.json" "$HOME/.plannotator/config.json"
