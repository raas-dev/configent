# Download the Chromium binary CloakBrowser fingerprints.
# Idempotent: cloakbrowser checks SHA256SUMS and skips on match.

set -eu

# Download the Chromium binary CloakBrowser fingerprints.
# Idempotent: cloakbrowser checks SHA256SUMS and skips on match.

# pipefail isn't POSIX sh; cloakbrowser may emit non-zero noise on stderr
mise exec pipx:cloakbrowser -- cloakbrowser install --quiet 2>/dev/null || true
