#!/bin/sh

# configent (https://github.com/raas-dev/configent)
# One command automated macOS/Linux laptop/VM/container bootstrapper.
#
# Copyright(C) 2016- Anssi Syrjäsalo (http://a.syrjasalo.com)
# Licensed under GNU Lesser General Public License v3 (LGPL-3.0).

trap "printf '\nCaught ^C from user - exiting now\n' ; exit 130" INT

### constants ##################################################################

this_path=$(cd "$(dirname "$0")" && pwd)
backup_path="$this_path/../.backup"
config_path="$HOME/.config/configent"

### mise #######################################################################

# backup dir
if [ ! -r "$backup_path/.config/mise" ]; then
  if [ -r "$HOME/.config/mise" ]; then
    mkdir -p "$backup_path/.config"
    cp -RP "$HOME/.config/mise" "$backup_path/.config/mise"
  fi
fi

# symlink dir
mkdir -p "$HOME/.config"
rm -rf "$HOME/.config/mise"
ln -sfnv "$config_path/mise" "$HOME/.config/mise"

# install mise
export PATH="$HOME/.local/bin:$PATH"
! command -v mise >/dev/null && curl https://mise.run | sh

# self-update mise
mise self-update --yes

# Alpine musl: inline exports so this run picks them up. The persistent
# block lives in dotfiles/.profile (alpine-gated) and is sourced on every
# login shell — no need to touch $HOME/.profile here.
if [ -f /etc/alpine-release ] && command -v mise >/dev/null 2>&1; then
  ARCH="$(uname -m)"
  case "$ARCH" in
  x86_64) CARGO_TARGET="x86_64-unknown-linux-musl" ;;
  aarch64) CARGO_TARGET="aarch64-unknown-linux-musl" ;;
  *) CARGO_TARGET="" ;;
  esac
  export MISE_NODE_OS="linux-musl"
  export MISE_NODE_COMPILE="0"
  export MISE_RUST_DEFAULT_TOOLCHAIN="stable"
  [ -n "$CARGO_TARGET" ] && export MISE_CARGO_DEFAULT_TARGET="$CARGO_TARGET"
  export PIP_NO_BINARY=""
  export _PIP_STANDALONE_BUILD="1"
fi

# set GOPATH before installing Go tools to prevent creating $HOME/go
export GOPATH="$HOME/.go"

# pre-baked tool installs (see dev.yaml mise-installs mount) — extract first
# so `mise install` treats them as already installed and skips re-downloading;
# version bumps still install fresh (tar holds a fixed version)
if [ -d /mnt/lima-provision/mise-installs ]; then
  mkdir -p "$HOME/.local/share/mise/installs"
  for tarball in /mnt/lima-provision/mise-installs/*.tar; do
    tar -xf "$tarball" -C "$HOME/.local/share/mise/installs/"
  done
  mise reshim
  # mise skips postinstall hooks for already-installed tools; these hooks
  # touch state needed every provision: omp agent configs, pip self-update
  for hook in postinstall_omp postinstall_python; do
    [ -x "$HOME/configent/bin/$hook" ] && "$HOME/configent/bin/$hook"
  done
fi

# install all enabled tools
mise install --yes
