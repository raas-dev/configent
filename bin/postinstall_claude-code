#!/bin/sh

# configent (https://github.com/raas-dev/configent)
# One command automated macOS/Linux laptop/VM/container bootstrapper.
#
# Copyright(C) 2016- Anssi Syrjäsalo (http://a.syrjasalo.com)
# Licensed under GNU Lesser General Public License v3 (LGPL-3.0).

### constants ##################################################################

this_path=$(cd "$(dirname "$0")" && pwd)
backup_path="$this_path/../.backup"
config_path="$HOME/.config/configent"

### configs ####################################################################

# files
# shellcheck disable=SC2043
for file in settings.json; do
  if [ ! -r "$backup_path/.claude/$file" ]; then
    if [ -r "$HOME/.claude/$file" ]; then
      mkdir -p "$backup_path/.claude"
      cp -P "$HOME/.claude/$file" "$backup_path/.claude/$file"
    fi
  fi
  mkdir -p "$HOME/.claude"
  ln -sfnv "$config_path/claude-code/$file" "$HOME/.claude/$file"
done

# dirs
for dir in commands agents hooks; do
  if [ ! -r "$backup_path/.claude/$dir" ]; then
    if [ -r "$HOME/.claude/$dir" ]; then
      mkdir -p "$backup_path/.claude/$dir"
      cp -RP "$HOME/.claude/$dir" "$backup_path/.claude/$dir"
    fi
  fi
  mkdir -p "$HOME/.claude"
  rm -rf "$HOME/.claude/$dir"
  ln -sfnv "$config_path/claude-code/$dir" "$HOME/.claude/$dir"
done

# skills; shared with standard agent skills dir
if [ ! -r "$backup_path/.claude/skills" ]; then
  if [ -r "$HOME/.claude/skills" ]; then
    mkdir -p "$backup_path/.claude/skills"
    cp -RP "$HOME/.claude/skills" "$backup_path/.claude/skills"
  fi
fi
mkdir -p "$HOME/.claude"
rm -rf "$HOME/.claude/skills"
ln -sfnv "$config_path/agents/skills" "$HOME/.claude/skills"

# CLAUDE.md; shared with standard AGENTS.md
if [ ! -r "$backup_path/.claude/CLAUDE.md" ]; then
  if [ -r "$HOME/.claude/CLAUDE.md" ]; then
    mkdir -p "$backup_path/.claude"
    cp -P "$HOME/.claude/CLAUDE.md" "$backup_path/.claude/CLAUDE.md"
  fi
fi
mkdir -p "$HOME/.claude"
rm -rf "$HOME/.claude/CLAUDE.md"
ln -sfnv "$config_path/agents/AGENTS.md" "$HOME/.claude/CLAUDE.md"

# token-optimizer config; freezes hook self-heal throttle so launching omp
# does not mutate claude-code settings.json (see etc/claude-code/token-optimizer)
if [ ! -r "$backup_path/.claude/token-optimizer/config.json" ]; then
  if [ -r "$HOME/.claude/token-optimizer/config.json" ]; then
    mkdir -p "$backup_path/.claude/token-optimizer"
    cp -P "$HOME/.claude/token-optimizer/config.json" \
      "$backup_path/.claude/token-optimizer/config.json"
  fi
fi
mkdir -p "$HOME/.claude/token-optimizer"
ln -sfnv "$config_path/claude-code/token-optimizer/config.json" \
  "$HOME/.claude/token-optimizer/config.json"

### ccstatusline ###############################################################

# ccstatusline binary
if command -v mise >/dev/null 2>&1; then
  mise exec node -- npm install -g ccstatusline
fi

# ccstatusline/settings.json
if [ ! -r "$backup_path/.config/ccstatusline/settings.json" ]; then
  if [ -r "$HOME/.config/ccstatusline/settings.json" ]; then
    mkdir -p "$backup_path/.config/ccstatusline"
    cp -P "$HOME/.config/ccstatusline/settings.json" \
      "$backup_path/.config/ccstatusline/settings.json"
  fi
fi
mkdir -p "$HOME/.config/ccstatusline"
ln -sfnv "$config_path/claude-code/ccstatusline/settings.json" \
  "$HOME/.config/ccstatusline/settings.json"

### ~/.agents dir ##############################################################

if [ ! -r "$backup_path/.agents" ]; then
  if [ -r "$HOME/.agents" ]; then
    mkdir -p "$backup_path/.agents"
    cp -RP "$HOME/.agents" "$backup_path/.agents"
  fi
fi
mkdir -p "$HOME/.agents"
rm -rf "$HOME/.agents"
ln -sfnv "$config_path/agents" "$HOME/.agents"

### plugins ####################################################################

#if command -v claude >/dev/null; then
#  # https://github.com/juliusbrussee/caveman
#  claude plugin marketplace add JuliusBrussee/caveman
#  claude plugin install caveman@caveman
#fi
