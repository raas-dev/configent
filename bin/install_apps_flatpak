#!/bin/sh

# configent (https://github.com/raas-dev/configent)
# One command automated macOS/Linux laptop/VM/container bootstrapper.
#
# Copyright(C) 2016- Anssi Syrjäsalo (http://a.syrjasalo.com)
# Licensed under GNU Lesser General Public License v3 (LGPL-3.0).

trap "printf '\nCaught ^C from user - exiting now\n' ; exit 130" INT

# https://flathub.org/
flatpak remote-add --user --if-not-exists \
  flathub https://flathub.org/repo/flathub.flatpakrepo

# LibreOffice
#flatpak install --user -y flathub org.libreoffice.LibreOffice

# sync only short-name aliases to ~/.local/bin (on PATH on most distros);
# flatpak exports live in ~/.local/share/flatpak/exports/bin under full app IDs
EXPORTS="$HOME/.local/share/flatpak/exports/bin"
LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN"
# shellcheck disable=SC2043
for cmd in libreoffice:org.libreoffice.LibreOffice; do
  short="${cmd%%:*}"
  app="${cmd#*:}"
  [ -x "$EXPORTS/$app" ] && ln -sf "$EXPORTS/$app" "$LOCAL_BIN/$short"
  # clean up full-ID links from earlier versions of this script
  [ -L "$LOCAL_BIN/$app" ] && rm "$LOCAL_BIN/$app"
done
