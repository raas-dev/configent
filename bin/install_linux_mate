#!/bin/bash
if [ "$(uname -s)" != "Linux" ]; then
  printf 'ERROR: install_linux_mate must be run on Linux.\n' >&2
  exit 1
fi

FORCE=0
case "${1:-}" in
--force)
  FORCE=1
  shift
  ;;
esac
while getopts 'f' opt; do
  case "$opt" in
  f) FORCE=1 ;;
  *)
    printf 'usage: %s [-f|--force]\n' "$0" >&2
    exit 64
    ;;
  esac
done

trap "printf '\nCaught ^C from user - exiting now\n' ; exit 130" INT

# ponytail: warm-boot fast path. First successful install touches this; selkies
# units are systemctl-enabled, so systemd brings them up on boot without us.
# Saves ~10 min on every `vm up dev` after the first cold install.
[ -f /var/tmp/desktop.done ] && [ "$FORCE" = 0 ] && exit 0

LUSER=$(getent passwd | awk -F: '$6 ~ /^\/home\// {print $1; exit}')
UHOME=$(getent passwd "$LUSER" | cut -d: -f6)
LUID=$(id -u "$LUSER")
LGROUP=$(getent group "$LUSER" | cut -d: -f1)

if [ "$(id -u)" = 0 ]; then
  SUDO=''
  export DEBIAN_FRONTEND=noninteractive
elif command -v sudo >/dev/null; then
  [ "$(id -un)" = "$LUSER" ] || {
    printf 'ERROR: must run as %s (got %s)\n' "$LUSER" "$(id -un)" >&2
    exit 1
  }
  SUDO='sudo DEBIAN_FRONTEND=noninteractive'
  sudo -n true || sudo -v
  while true; do
    sudo -n true
    sleep 60
    kill -0 "$$" || exit
  done 2>/dev/null &
else
  printf "\nERROR: User is non-root and sudo not available, cannot proceed.\n"
  exit 1
fi

run_as() { # $SUDO is empty when we *are* root; -u would become the command
  if [ -n "$SUDO" ]; then sudo -u "$LUSER" "$@"; else runuser -u "$LUSER" -- "$@"; fi
}

set -eu -o pipefail

log() { printf '[mate-install] %s %s\n' "$(date +%H:%M:%S)" "$*"; }

log 'starting install_linux_mate'
UI=$(CDPATH='' cd -- "$(dirname -- "$0")/../ui/mate" && pwd)
ARCH=$(dpkg --print-architecture)

APT_OPTS=(-y -o Acquire::Retries=3 --no-install-recommends
  -o Dpkg::Options::=--force-confdef
  -o Dpkg::Options::=--force-confold
  -o Dpkg::Options::=--force-unsafe-io
  -o "Dpkg::Path-Exclude=/usr/share/doc/*"
  -o "Dpkg::Path-Include=/usr/share/doc/*/copyright"
  -o "Dpkg::Path-Exclude=/usr/share/man/*")

eatmydata_setup() {
  $SUDO dpkg -i /var/cache/apt/archives/eatmydata_*.deb \
    /var/cache/apt/archives/libeatmydata1_*.deb >/dev/null 2>&1 ||
    $SUDO apt-get install "${APT_OPTS[@]}" eatmydata >/dev/null 2>&1 || true
}

wait_ok() {
  wait "$1" || {
    cat "$2" >&2
    exit 1
  }
}

selkies_deb() {
  case "$ARCH" in
  amd64) DEB=selkies-2.0.0rc0-ubuntu26.04-amd64.deb ;;
  arm64) DEB=selkies-2.0.0rc0-ubuntu26.04-arm64.deb ;;
  *)
    printf 'ERROR: unsupported arch %s\n' "$ARCH" >&2
    return 1
    ;;
  esac
  if [ -f "/mnt/lima-provision/$DEB" ]; then
    cp "/mnt/lima-provision/$DEB" "/tmp/$DEB"
    return 0
  fi
  curl -fsSL --retry 5 --retry-all-errors -o "/tmp/$DEB" \
    "https://github.com/selkies-project/selkies/releases/download/2.0.0rc0/${DEB}"
  [ -w /mnt/lima-provision ] && cp "/tmp/$DEB" /mnt/lima-provision/ || true
}

# Latest free CloakBrowser Chromium straight from GitHub Releases. Archive
# cached on the lima-provision volume like the selkies deb, so reprovisioned
# instances skip the ~200MB download.
chromium_dl() {
  case "$ARCH" in
  amd64) CBPLAT=linux-x64 ;;
  arm64) CBPLAT=linux-arm64 ;;
  *)
    printf 'ERROR: unsupported arch %s\n' "$ARCH" >&2
    return 1
    ;;
  esac
  local tag want
  CBV=''
  # Newest free tag that actually ships an archive for this arch; the numeric
  # grep skips -pro/-preview tags (arm64 free releases can lag x64).
  for tag in $(curl -fsSL "https://api.github.com/repos/CloakHQ/cloakbrowser/releases?per_page=30" |
    grep -oE '"tag_name": *"chromium-v[0-9.]+"' | grep -oE 'chromium-v[0-9.]+'); do
    curl -fsIL -o /dev/null \
      "https://github.com/CloakHQ/cloakbrowser/releases/download/$tag/cloakbrowser-$CBPLAT.tar.gz" &&
      CBV=$tag && break
  done
  TARBALL="cloakbrowser-$CBPLAT.tar.gz"
  CACHED="/mnt/lima-provision/cloakbrowser-$CBPLAT-$CBV.tar.gz"
  # SRC: what to extract. Cache hits read the provision volume directly —
  # no ~200MB staging copy into /tmp; only the fresh-download path stages.
  if [ -n "$CBV" ] && [ -f "$CACHED" ]; then
    SRC=$CACHED
  elif [ -n "$CBV" ]; then
    SRC="/tmp/$TARBALL"
    curl -fsSL --retry 5 --retry-all-errors -o "$SRC" \
      "https://github.com/CloakHQ/cloakbrowser/releases/download/$CBV/$TARBALL" || return 1
    want=$(curl -fsSL "https://github.com/CloakHQ/cloakbrowser/releases/download/$CBV/SHA256SUMS" |
      awk -v f="$TARBALL" '$2==f || $2=="*"f {print $1}')
    [ -n "$want" ] || return 1
    echo "$want  $SRC" | sha256sum -c - || return 1
    [ -w /mnt/lima-provision ] && cp "$SRC" "$CACHED" || true
  else
    # GitHub unreachable: newest cached archive for this arch.
    CACHED=$(find /mnt/lima-provision -maxdepth 1 -name "cloakbrowser-$CBPLAT-*.tar.gz" 2>/dev/null | sort -V | tail -1)
    [ -f "$CACHED" ] || return 1
    CBV="chromium-${CACHED##*cloakbrowser-"$CBPLAT"-}"
    CBV="${CBV%.tar.gz}"
    SRC=$CACHED
  fi
}

chromium_files() {
  # Extract into ~/.local/share/cloakbrowser/chromium-<v>/chrome — the
  # layout the wrapper expects (newest wins, sort -V). Flattens the single
  # top-level dir in the archive.
  # shellcheck disable=SC2016  # runs as another user; $1..$3 expand inside, not here
  run_as bash -c '
    set -e
    d="$1/.local/share/cloakbrowser/chromium-${2#chromium-v}"
    rm -rf "$d"; mkdir -p "$d"
    tar -xzf "$3" -C "$d"
    sub=$(ls -A "$d")
    if [ "$(printf "%s\n" "$sub" | wc -l)" -eq 1 ] && [ -d "$d/$sub" ]; then
      mv "$d/$sub"/* "$d"/ && rmdir "$d/$sub"
    fi
    # prune stale versions (persistent limahome accumulates them)
    for o in "$(dirname "$d")"/chromium-*; do
      if [ -d "$o" ] && [ "$o" != "$d" ]; then rm -rf "$o"; fi
    done
    [ -x "$d/chrome" ]
  ' _ "$UHOME" "$CBV" "$SRC"
}

# chromium_dl runs as a bg subshell, so its CBV/SRC can't propagate to the
# parent. Publish them for chromium_files_bg.
chromium_dl_main() {
  chromium_dl || return 1
  printf 'CBV=%q\nSRC=%q\n' "$CBV" "$SRC" >/tmp/cb.env
  touch /tmp/cb.ok
}

# Extract off the critical path: spin until chromium_dl publishes cb.env,
# then extract while the apt batch is still running.
chromium_files_bg() {
  local i=0
  until [ -f /tmp/cb.ok ] && . /tmp/cb.env; do
    i=$((i + 1))
    [ "$i" -gt 600 ] && return 1
    sleep 0.5
  done
  chromium_files
}

# Store CRXs unpacked versionless outside the profile (GC-safe); the
# chromium-wrapper mounts them via --load-extension. Chromium will not
# accept hand-registered user extensions (Secure Preferences MACs), so
# seeding extensions.settings is pointless.
chromium_extensions() {
  $SUDO install -d -o "$LUSER" -m 755 "$UHOME/.config/chromium-extensions"
  run_as python3 "$UI/../chromium/extensions.py" \
    "$UHOME/.config/chromium-extensions" \
    "$UHOME/.config/chromium/Default/Preferences"
}
chromium_launcher() {
  # Seeded profile (First Run sentinel, no default-browser prompt, pinned
  # toolbar extensions) — same as xfce. Wipe first so re-installs re-seed
  # instead of merging into a possibly-corrupt profile.
  $SUDO rm -rf "$UHOME/.config/chromium" "$UHOME/.cache/chromium" 2>/dev/null || true
  $SUDO install -d -o "$LUSER" -m 755 "$UHOME/.config/chromium"
  $SUDO cp -r "$UI/../chromium/default-profile/Default/." \
    "$UHOME/.config/chromium/Default/"
  $SUDO install -o "$LUSER" -m 644 "$UI/../chromium/default-profile/Local State" \
    "$UHOME/.config/chromium/Local State"
  $SUDO install -o "$LUSER" -m 644 "$UI/../chromium/default-profile/First Run" \
    "$UHOME/.config/chromium/First Run"
  $SUDO chown -R "$LUSER": "$UHOME/.config/chromium"
  # Store CRXs on disk + --load-extension wrapper; user-managed (no
  # policies, no /etc, no "managed by your organization").
  chromium_extensions
  for n in chrome chromium chromium-browser; do
    $SUDO ln -sf /usr/local/bin/chromium-wrapper /usr/local/bin/$n
  done
  # chrome checks the desktop-file id "chromium-browser.desktop" against
  # xdg-settings to decide "is default browser" — must match exactly.
  $SUDO install -d -m 755 /usr/local/share/applications
  $SUDO install -m 644 "$UI/chromium-browser.desktop" \
    /usr/local/share/applications/chromium-browser.desktop
  $SUDO update-desktop-database /usr/local/share/applications 2>/dev/null || true
  # Desktop launchers: ours + drop stale ones from the other DE profile.
  mkdir -p "$UHOME/Desktop" "$UHOME/.local/share/applications"
  install -m 755 /usr/local/share/applications/chromium-browser.desktop \
    "$UHOME/Desktop/chromium-browser.desktop"
  install -m 644 /usr/local/share/applications/chromium-browser.desktop \
    "$UHOME/.local/share/applications/chromium-browser.desktop"
  install -m 755 "$UI/mate-terminal.desktop" \
    "$UHOME/Desktop/mate-terminal.desktop"
  install -m 644 "$UI/mate-terminal.desktop" \
    "$UHOME/.local/share/applications/mate-terminal.desktop"
  rm -f \
    "$UHOME/Desktop/xfce4-terminal.desktop" \
    "$UHOME/Desktop/chromium.desktop" \
    "$UHOME/.local/share/applications/xfce4-terminal.desktop" \
    "$UHOME/.local/share/applications/chromium.desktop"
  gio set "$UHOME/Desktop/chromium-browser.desktop" \
    metadata::trusted true 2>/dev/null || true
  gio set "$UHOME/Desktop/mate-terminal.desktop" \
    metadata::trusted true 2>/dev/null || true
  # gvfsd-metadata may be absent; Caja/Thunar honor this xattr fallback.
  run_as python3 -c "
import os
for f in ('$UHOME/Desktop/chromium-browser.desktop',
          '$UHOME/Desktop/mate-terminal.desktop'):
    try: os.setxattr(f, 'user.gvfs.trust', b'1')
    except OSError: pass
" 2>/dev/null || true
  $SUDO install -m 644 "$UI/99-chromium-userns.conf" /etc/sysctl.d/99-chromium-userns.conf
  $SUDO sysctl -p /etc/sysctl.d/99-chromium-userns.conf
  if [ "$(id -u)" = 0 ]; then
    chown -R "$LUSER": "$UHOME/Desktop" "$UHOME/.local/share/applications"
  fi
}

install_selkies_configs() {
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" "$UI/xvfb.service" |
    $SUDO tee /etc/systemd/system/xvfb.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/xvfb.service
  $SUDO install -m 644 "$UI/keyboard-default" /etc/default/keyboard
  # Install to the persistent lima share (survives `limactl delete` and the
  # ephemeral zero-byte copy that ends up under /usr/local/bin on vz).
  $SUDO install -d -m 755 /mnt/lima-limahome/.local/bin
  $SUDO install -m 755 "$UI/selkies-session" /mnt/lima-limahome/.local/bin/selkies-session
  # Mirror to /usr/local/bin for PATH consistency, but the service runs the
  # persistent copy so the boot path is never an empty file.
  $SUDO install -m 755 "$UI/selkies-session" /usr/local/bin/selkies-session
  $SUDO sh -c '[ -f /etc/ssl/selkies.pem ] || (openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=localhost" \
    -keyout /etc/ssl/selkies.pem -out /tmp/sk.crt && \
    cat /tmp/sk.crt >> /etc/ssl/selkies.pem && rm -f /tmp/sk.crt && \
    chmod 644 /etc/ssl/selkies.pem)'
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" "$UI/selkies-tls.service" |
    $SUDO tee /etc/systemd/system/selkies-tls.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/selkies-tls.service
  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" -e "s|__LUID__|$LUID|g" \
    "$UI/selkies-autostart.service" | $SUDO tee /etc/systemd/system/selkies-autostart.service >/dev/null
  $SUDO chmod 644 /etc/systemd/system/selkies-autostart.service
  $SUDO loginctl enable-linger "$LUSER" 2>/dev/null || true
  $SUDO systemctl daemon-reload 2>/dev/null || true
}

enable_selkies_units() {
  $SUDO systemctl enable --now xvfb 2>/dev/null || true
  $SUDO systemctl enable --now selkies-tls selkies-autostart 2>/dev/null || true
}

write_mate_extras() {
  $SUDO install -m 755 "$UI/chromium-wrapper" /usr/local/bin/chromium-wrapper
  [ -f /usr/share/backgrounds/ubuntu-mate-common/Ubuntu-MATE-Splash.jpg ] && gsettings set \
    org.mate.background picture-filename \
    '/usr/share/backgrounds/ubuntu-mate-common/Ubuntu-MATE-Splash.jpg'
  $SUDO chmod 755 /usr/share/backgrounds
  $SUDO systemctl mask \
    mate-session.service 'mate-session@*.service' \
    mate-settings-daemon.service 'mate-settings-daemon@*.service' \
    mate-panel.service 'mate-panel@*.service' 2>/dev/null || true
  $SUDO rm -f \
    /etc/xdg/autostart/mate-panel.desktop \
    /etc/xdg/autostart/mate-power-manager.desktop \
    /etc/xdg/autostart/mate-screensaver.desktop \
    /etc/xdg/autostart/nemo-desktop.desktop \
    /etc/systemd/system/mate-autostart.service 2>/dev/null || true
}

factory_reset_and_apply() {
  $SUDO rm -rf \
    "$UHOME/.config/mate" \
    "$UHOME/.config/mate-session" \
    "$UHOME/.config/mate-panel" \
    "$UHOME/.config/Caja" \
    "$UHOME/.cache/mate-session" \
    "$UHOME/.cache/mate-panel" \
    "$UHOME/.cache/Caja" \
    "$UHOME/.local/share/mate"

  chromium_launcher

  mkdir -p "$UHOME/.config" "$UHOME/.local/share/applications"
  install -m 644 \
    "$UI/mimeapps.user.list" "$UHOME/.config/mimeapps.list"
  install -m 644 \
    "$UI/chromium-browser.desktop" \
    "$UHOME/.local/share/applications/chromium-browser.desktop"

  "$UI/apply-gsettings.sh" "$LUSER"

  sed -e "s|__LUSER__|$LUSER|g" -e "s|__LGROUP__|$LGROUP|g" -e "s|__LUID__|$LUID|g" \
    "$UI/mate-autostart.service" \
    >"$UHOME/.config/systemd/user/mate-autostart.service"
  chmod 644 "$UHOME/.config/systemd/user/mate-autostart.service"
  $SUDO systemctl daemon-reload 2>/dev/null || true

  if [ "$(id -u)" = 0 ]; then
    chown -R "$LUSER": \
      "$UHOME/.config/systemd/user" \
      "$UHOME/.local/share/applications" 2>/dev/null || true
    $SUDO runuser -u "$LUSER" -- env \
      HOME="$UHOME" XDG_RUNTIME_DIR="/run/user/$LUID" \
      systemctl --user enable --now mate-autostart.service 2>/dev/null || true
  else
    XDG_RUNTIME_DIR="/run/user/$LUID" \
      systemctl --user enable --now mate-autostart.service 2>/dev/null || true
  fi
}

LOGDIR=/var/log/mate-install
$SUDO mkdir -p -m 755 "$LOGDIR"
$SUDO chown "$LUSER": "$LOGDIR"

rm -f "$LOGDIR"/*.log

exec > >(tee -a "$LOGDIR/install_linux_mate.log") 2>&1

# Skip update if install.sh preamble already updated index this boot.
{ [ -f /run/configent-apt-updated ] ||
  $SUDO apt-get update -o Acquire::Languages=none -o Acquire::Retries=3; } \
  >"$LOGDIR/apt.log" 2>&1 &
UP=$!
selkies_deb >"$LOGDIR/selkdeb.log" 2>&1 &
SDB=$!
chromium_dl_main >"$LOGDIR/cb.log" 2>&1 &
CB=$!
chromium_files_bg >"$LOGDIR/cbf.log" 2>&1 &
CBF=$!
install_selkies_configs >"$LOGDIR/cfg.log" 2>&1 &
CFG=$!
# ponytail: eatmydata bypasses fsync/fdatasync during apt's many commits
# (30-50% off cold installs on slow disks). Base image ships the debs in the
# apt archives cache, so dpkg -i needs no index and runs concurrently with
# apt-get update. dpkg lock is free at this point (batch starts later).
eatmydata_setup >"$LOGDIR/emd.log" 2>&1 &
EMD=$!

wait_ok "$UP" "$LOGDIR/apt.log"
log "apt index updated"
# Optional accelerator — never fatal (plain apt is the fallback).
wait "$EMD" || true
EAT='' # 'eatmydata' once preload lands; plain apt otherwise
dpkg -s eatmydata >/dev/null 2>&1 && EAT=eatmydata &&
  log "eatmydata enabled (fsync bypass → faster apt)"

log "waiting for selkies deb"
wait_ok "$SDB" "$LOGDIR/selkdeb.log"
SELKIES_DEB="/tmp/selkies-2.0.0rc0-ubuntu26.04-${ARCH}.deb"
[ -f "$SELKIES_DEB" ] || {
  cat "$LOGDIR/selkdeb.log" >&2
  exit 1
}

log "apt + selkies + mate install starting (single batch)"
{
  $SUDO $EAT apt-get install "${APT_OPTS[@]}" \
    "$SELKIES_DEB" \
    xvfb \
    x11-xkb-utils xkb-data fontconfig fonts-dejavu-core dbus-x11 \
    socat libnspr4 libnss3 \
    ubuntu-mate-desktop ubuntu-mate-default-settings \
    ubuntu-mate-icon-themes ubuntu-mate-themes \
    ayatana-indicator-application mate-terminal \
    at-spi2-core libatk-adaptor libatk-bridge2.0-0t64 \
    dconf-cli \
    pipewire pipewire-pulse wireplumber \
    ubuntu-mate-wallpapers-common \
    fonts-ubuntu \
    mesa-vulkan-drivers \
    glmark2-es2-drm
  # Venus via mesa-vulkan-drivers becomes real once libkrun #114 lands.
  # When fixed: switch chromium-wrapper to --use-angle=vulkan (drops SwiftShader).
} 2>&1 | tee "$LOGDIR/core.log" >/dev/null || {
  tail -60 "$LOGDIR/core.log" >&2
  exit 1
}
rm -f "$SELKIES_DEB"
log "apt + selkies + mate installed"

# Wait for backgrounds we still need: chromium_dl (factory_reset reads
# the cloakbrowser tree), install_selkies_configs
# (selkies unit files must exist before enable_selkies_units).
wait_ok "$CB" "$LOGDIR/cb.log"
wait_ok "$CBF" "$LOGDIR/cbf.log"
wait_ok "$CFG" "$LOGDIR/cfg.log"
log "selkies configs + chromium ready"

# ponytail: selkies start, factory reset, and mate extras all run concurrently
# and are waited on below. lima probe waits on
# selkies-tls :8080; mate-autostart brings up the session. Both ready by
# the time wait_ok SRV/FAC return.
enable_selkies_units >"$LOGDIR/selk.log" 2>&1 &
SRV=$!
factory_reset_and_apply >"$LOGDIR/factory.log" 2>&1 &
FAC=$!
write_mate_extras >"$LOGDIR/cfg2.log" 2>&1 &
EXTRAS=$!

wait_ok "$FAC" "$LOGDIR/factory.log"
wait_ok "$EXTRAS" "$LOGDIR/cfg2.log"
wait_ok "$SRV" "$LOGDIR/selk.log"

log "mate done"
touch /var/tmp/desktop.done
