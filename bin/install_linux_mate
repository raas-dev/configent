#!/bin/bash
# Linux-only. Refuses to run on macOS/BSD hosts — script needs dpkg, getent,
# and the lima virtiofs mount which only exist inside the VM.
if [ "$(uname -s)" != "Linux" ]; then
  printf 'ERROR: install_linux_mate must run inside the Linux VM.\n' >&2
  exit 1
fi

trap "printf '\nCaught ^C from user - exiting now\n' ; exit 130" INT

log() { printf '[mate-install] %s %s\n' "$(date +%H:%M:%S)" "$*"; }

LUSER=$(getent passwd | awk -F: '$6 ~ /^\/home\// {print $1; exit}')
UHOME=$(getent passwd "$LUSER" | cut -d: -f6)
LUID=$(id -u "$LUSER")
UI=$(CDPATH='' cd -- "$(dirname -- "$0")/../ui/mate" && pwd)

if [ "$(id -u)" = 0 ]; then SUDO=''; else SUDO='sudo'; fi
export SUDO

# Single-run guard. flock prevents two invocations from racing.
# === System-side ===
# Things that genuinely need root: port-8080 web listener (selkies),
# /etc/X11 keyboard config, xorg-dummy display, system chromium wrapper.
$SUDO install -m 644 "$UI/xorg-dummy.service" /etc/systemd/system/xorg-dummy.service
$SUDO loginctl enable-linger "$LUSER"
$SUDO install -d /etc/X11/xorg.conf.d
$SUDO install -m 644 "$UI/00-keyboard.conf" /etc/X11/xorg.conf.d/00-keyboard.conf
$SUDO install -m 644 "$UI/keyboard-default" /etc/default/keyboard
$SUDO install -m 644 "$UI/10-dummy.conf" /etc/X11/xorg.conf.d/10-dummy.conf
$SUDO systemctl enable xorg-dummy

$SUDO install -m 755 "$UI/selkies-session" /usr/local/bin/selkies-session
$SUDO sh -c 'openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=localhost" \
  -keyout /etc/ssl/selkies.pem -out /tmp/sk.crt && \
  cat /tmp/sk.crt >> /etc/ssl/selkies.pem && rm -f /tmp/sk.crt'
$SUDO install -m 644 "$UI/selkies-tls.service" /etc/systemd/system/selkies-tls.service
$SUDO sed -e "s|__LUSER__|$LUSER|g" -e "s|__LUID__|$LUID|g" \
  "$UI/selkies-autostart.service" >/etc/systemd/system/selkies-autostart.service
$SUDO chmod 644 /etc/systemd/system/selkies-autostart.service
$SUDO systemctl enable selkies-tls selkies-autostart

$SUDO install -m 755 "$UI/chromium-wrapper" /usr/local/bin/chromium-wrapper

# Mask every system-side mate unit so the package can never start it. The
# single mate-session we run comes from the user's systemd unit.
$SUDO systemctl mask \
  mate-session.service 'mate-session@*.service' \
  mate-settings-daemon.service 'mate-settings-daemon@*.service' \
  mate-panel.service 'mate-panel@*.service' 2>/dev/null || true
$SUDO rm -f \
  /etc/xdg/autostart/mate-panel.desktop \
  /etc/xdg/autostart/mate-power-manager.desktop \
  /etc/xdg/autostart/mate-screensaver.desktop \
  /etc/xdg/autostart/nemo-desktop.desktop \
  /etc/systemd/system/mate-autostart.service 2>/dev/null || true

# === User-side factory reset ===
# Kill live processes, wipe leftover state, reinit dirs as user. Doing this
# as user (not root) means the new dirs are owned by LUSER by default.
$SUDO pkill -9 -u "$LUSER" -f mate-session 2>/dev/null || true
$SUDO pkill -9 -u "$LUSER" -f mate-panel 2>/dev/null || true
$SUDO pkill -9 -u "$LUSER" -f mate-settings-daemon 2>/dev/null || true
$SUDO pkill -9 -u "$LUSER" -f dconf-service 2>/dev/null || true
sleep 1
$SUDO rm -rf \
  "$UHOME/.config/mate" \
  "$UHOME/.config/mate-session" \
  "$UHOME/.config/mate-panel" \
  "$UHOME/.config/Caja" \
  "$UHOME/.config/dconf" \
  "$UHOME/.config/mimeapps.list" \
  "$UHOME/.cache/dconf" \
  "$UHOME/.cache/mate-session" \
  "$UHOME/.cache/mate-panel" \
  "$UHOME/.cache/Caja" \
  "$UHOME/.local/share/mate" \
  "/run/user/$LUID/dconf"

# === User-side apply ===
# Mime + chromium .desktop for the user.
$SUDO install -d -o "$LUSER" -g "$LUSER" -m 755 "$UHOME/.config" "$UHOME/.local/share/applications"
$SUDO install -o "$LUSER" -g "$LUSER" -m 644 "$UI/mimeapps.user.list" "$UHOME/.config/mimeapps.list"
$SUDO install -o "$LUSER" -g "$LUSER" -m 644 "$UI/chromium.desktop" "$UHOME/.local/share/applications/chromium.desktop"

# Apply defaults by talking to the running user dbus via `gsettings set`.
# This is the ONLY setting mechanism that works: `dconf load` writes
# ~/.config/dconf/user on disk but dconf-service caches in memory and
# doesn't reload from disk; vendor gschema.overrides set defaults but are
# overridden by user db; the user db keyfile (text) is not read under
# profile `user-db:user` — only the compiled binary is.
"$UI/apply-gsettings.sh" "$LUSER"

# Author mate-autostart in user systemd; the user systemd runs it on session
# start (selkies-websockets drops env at login + sets XDG_SESSION_ID).
$SUDO install -d -o "$LUSER" -g "$LUSER" -m 700 \
  "$UHOME/.config/systemd/user"
sed -e "s|__LUSER__|$LUSER|g" -e "s|__LUID__|$LUID|g" \
  "$UI/mate-autostart.service" |
  $SUDO tee "$UHOME/.config/systemd/user/mate-autostart.service" >/dev/null
$SUDO chmod 644 "$UHOME/.config/systemd/user/mate-autostart.service"
$SUDO systemctl daemon-reload 2>/dev/null || true

# Start mate-autostart as the user. Single entry point: the factory-reset
# pkill above already cleared stragglers; starting again here would race
# the systemd unit against itself.
$SUDO runuser -u "$LUSER" -- env \
  HOME="$UHOME" XDG_RUNTIME_DIR="/run/user/$LUID" \
  systemctl --user start mate-autostart.service 2>/dev/null || true

log "mate done"
