{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": false
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "codebase-memory-mcp": {
      "command": [
        "codebase-memory-mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "external_directory": "allow",
    "read": {
      "*": "allow"
    }
  },
  "plugin": [
    "billion-context",
    "token-optimizer-opencode",
    "@dietrichgebert/ponytail",
    "@mumme-it/opencode-caveman",
    "@slkiser/opencode-quota"
  ],
  "share": "disabled"
}
