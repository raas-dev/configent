{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.3",
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "provider": {
    "zai-coding-plan": {
      "npm": "@ai-sdk/anthropic",
      "name": "occam",
      "options": {
        "baseURL": "https://gw.alkue.dev/v1",
        "apiKey": "{env:OCCAM_API_KEY}",
        "headers": {
          "x-litellm-api-key": "{env:OCCAM_API_KEY}",
          "x-api-key": "{env:ZAI_API_KEY}"
        }
      },
      "models": {
        "glm-5.3": { "name": "glm-5.3" },
        "glm-5.2": { "name": "glm-5.2" }
      }
    }
  },
  "mcp": {
    "zai-vision": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "{env:ZAI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    }
  }
}
