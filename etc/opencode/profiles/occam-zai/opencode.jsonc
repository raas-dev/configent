{
  "$schema": "https://opencode.ai/config.json",
  "model": "occam/glm-5.3",
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "provider": {
    "occam": {
      "name": "Occam",
      "npm": "@ai-sdk/anthropic",
      "options": {
        // ponytail: @ai-sdk/anthropic appends /messages (NOT /v1/messages), so baseURL must include /v1
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:OCCAM_API_KEY}"
      },
      "models": {
        "glm-5.3": { "name": "GLM 5.3" },
        "glm-5.2": { "name": "GLM 5.2" },
        "MiniMax-M3": { "name": "MiniMax M3" }
      }
    }
  },
  "mcp": {
    "zai-vision": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "{env:ZAI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    }
  }
}
