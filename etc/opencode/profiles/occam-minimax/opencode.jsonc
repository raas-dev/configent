{
  "$schema": "https://opencode.ai/config.json",
  "model": "occam/MiniMax-M3",
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "provider": {
    "occam": {
      "name": "Occam",
      "npm": "@ai-sdk/anthropic",
      "options": {
        // ponytail: @ai-sdk/anthropic appends /messages (NOT /v1/messages), so baseURL must include /v1
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:OCCAM_API_KEY}"
      },
      "models": {
        "glm-5.2": { "name": "GLM 5.2" },
        "MiniMax-M3": { "name": "MiniMax M3" }
      }
    }
  },
  "mcp": {
    "minimax-vision": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<1.10",
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "environment": {
        "MINIMAX_API_KEY": "{env:MINIMAX_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimax.io"
      },
      "enabled": true
    }
  }
}
