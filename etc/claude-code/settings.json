{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Agent",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "ToolSearch",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(git *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.backup/**)",
      "Read(**/*.log)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": true,
  "includeGitInstructions": false,
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "cleanupPeriodDays": 99999
}
