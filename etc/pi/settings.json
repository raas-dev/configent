{
  "autocompleteMaxVisible": 15,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "defaultModel": "MiniMax-M3",
  "defaultProvider": "occam/minimax",
  "defaultThinkingLevel": "medium",
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.80.2",
  "packages": [
    "npm:billion-context-pi",
    "npm:pi-context-view",
    "npm:pi-fabric",
    "npm:pi-fovea",
    "npm:pi-image-tools",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    "npm:pi-open-tui",
    "npm:pi-rewind-hook",
    "npm:pi-rtk-optimizer",
    "npm:pi-tool-repair",
    "npm:pi-web-access",
    "npm:@baylarsadigov/omp-undo-redo",
    "npm:@gamaraan/todos-tool",
    "npm:@hk_net/pi-usage-bars",
    "npm:@jmcombs/pi-prompt-enhancer",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@mjasnikovs/pi-task",
    "npm:@monotykamary/pi-loop",
    "npm:@monotykamary/pi-retry",
    "npm:@monotykamary/pi-vcc",
    "npm:@narumitw/pi-btw",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:@zhcsyncer/pi-tool-display-intent",
    "git:github.com/asyrjasalo/omp-headroom",
    "git:github.com/asyrjasalo/pi-supervisor",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/iodic/pi-ayu-themes",
    "git:github.com/jonjonrankin/pi-caveman",
    "git:github.com/monotykamary/pi-double-esc"
  ],
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 2000,
    "enabled": true,
    "maxRetries": 10,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000,
      "timeoutMs": 3600000
    }
  },
  "rewind": {
    "retention": {
      "maxAgeDays": 30,
      "maxSnapshots": 2000,
      "pinLabeledEntries": true
    },
    "silentCheckpoints": true
  },
  "showHardwareCursor": true,
  "steeringMode": "all",
  "theme": "ayu-dark",
  "transport": "auto",
  "treeFilterMode": "user-only",
  "defaultProjectTrust": "always"
}
