{
  "autocompleteMaxVisible": 15,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "defaultModel": "MiniMax-M3",
  "defaultProjectTrust": "always",
  "defaultProvider": "occam/minimax",
  "defaultThinkingLevel": "medium",
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.85.0",
  "packages": [
    "npm:billion-context",
    "npm:pi-context-view",
    "npm:pi-image-view",
    "npm:pi-invisible-continue",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    "npm:pi-open-tui",
    "npm:pi-workspace-history",
    "npm:pi-tool-repair",
    "npm:pi-tool-compact-display",
    "npm:pi-web-access",
    "npm:@gamaraan/ask-tool",
    "npm:@gamaraan/todos-tool",
    "npm:@hk_net/pi-usage-bars",
    "npm:@jmcombs/pi-prompt-enhancer",
    "npm:@monotykamary/pi-retry",
    "npm:@monotykamary/pi-supervisor",
    "npm:@narumitw/pi-btw",
    "npm:@normful/pi-auto-name",
    "git:github.com/alexgreensh/token-optimizer",
    "git:github.com/ayghri/i-have-adhd",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/iodic/pi-ayu-themes",
    "git:github.com/jonjonrankin/pi-caveman",
    "git:github.com/nicobailon/visual-explainer"
  ],
  "quietStartup": true,
  "workspaceHistory": {
    "showStatus": false
  },
  "retry": {
    "baseDelayMs": 2000,
    "enabled": true,
    "maxRetries": 10,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000,
      "timeoutMs": 3600000
    }
  },
  "showHardwareCursor": true,
  "steeringMode": "all",
  "terminal": {
    "clearOnShink": true
  },
  "theme": "ayu-dark",
  "transport": "auto",
  "treeFilterMode": "user-only",
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "watchdog_diff",
          "contact_supervisor",
          "compress",
          "decompress",
          "search_context",
          "acp_status"
        ]
      },
      "oracle": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "compress",
          "decompress",
          "search_context",
          "acp_status"
        ]
      },
      "researcher": {
        "tools": [
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "compress",
          "decompress",
          "search_context",
          "acp_status"
        ]
      },
      "worker": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "compress",
          "decompress",
          "search_context",
          "acp_status"
        ]
      },
      "delegate": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "compress",
          "decompress",
          "search_context",
          "acp_status"
        ]
      },
      "scout": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "contact_supervisor",
          "compress",
          "decompress",
          "search_context",
          "acp_status"
        ]
      },
      "evidence-auditor": {
        "tools": [
          "read",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "compress",
          "decompress",
          "search_context",
          "acp_status"
        ]
      }
    }
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "llm-wiki": {
    "notices": false
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-image-view\",\"scope\":\"user\"}": "0.5.0",
