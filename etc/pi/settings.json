{
  "autocompleteMaxVisible": 15,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "defaultModel": "glm-5.3",
  "defaultProvider": "occam/zai",
  "defaultThinkingLevel": "medium",
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.80.2",
  "packages": [
    "npm:pi-ask-user",
    "npm:pi-codex-goal",
    "npm:pi-context-view",
    "npm:pi-fovea",
    "npm:pi-hodor",
    "npm:pi-image-tools",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    "npm:pi-open-tui",
    "npm:pi-ponytail",
    "npm:pi-rewind-hook",
    "npm:pi-rtk-optimizer",
    "npm:pi-tool-display",
    "npm:pi-web-access",
    "npm:billion-context-pi",
    "npm:@jmcombs/pi-prompt-enhancer",
    "npm:@juicesharp/rpiv-todo",
    "npm:@latentminds/pi-quotas",
    "npm:@sting8k/pi-vcc",
    "npm:@termdraw/pi",
    "git:github.com/iodic/pi-ayu-themes",
    "git:github.com/jonjonrankin/pi-caveman",
    {
      "extensions": [
        "extensions/anycopy/index.ts",
        "extensions/handover/index.ts",
        "extensions/session-switch/index.ts",
        "extensions/tools/index.ts",
        "extensions/files-touched.ts",
        "extensions/fork-from-first.ts",
        "extensions/md.ts",
        "extensions/move-session.ts",
        "extensions/plan-mode.ts",
        "extensions/session-name.ts"
      ],
      "source": "git:github.com/asyrjasalo/pi-extensions"
    }
  ],
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 2000,
    "enabled": true,
    "maxRetries": 10,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000,
      "timeoutMs": 3600000
    }
  },
  "rewind": {
    "retention": {
      "maxAgeDays": 30,
      "maxSnapshots": 2000,
      "pinLabeledEntries": true
    },
    "silentCheckpoints": true
  },
  "showHardwareCursor": true,
  "steeringMode": "all",
  "theme": "ayu-dark",
  "transport": "auto",
  "treeFilterMode": "user-only",
  "defaultProjectTrust": "always",
  "terminal": {
    "clearOnShrink": true
  }
}
