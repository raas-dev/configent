{
  "mcpServers": {
    "zai-vision": {
      "command": "npx",
      "args": [
        "@z_ai/mcp-server"
      ],
      "env": {
        "Z_AI_API_KEY": "${ZAI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      },
      "lifecycle": "lazy",
      "directTools": true
    },
    "context-mode": {
      "command": "context-mode",
      "lifecycle": "eager",
      "directTools": true
    }
  },
  "settings": {
    "toolPrefix": "none",
    "disableProxyTool": true
  }
}
