{
  "mcpServers": {
    "minimax-vision": {
      "command": "uvx",
      "args": [
        "minimax-coding-plan-mcp"
      ],
      "env": {
        "MINIMAX_API_KEY": "${MINIMAX_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimax.io"
      },
      "directTools": ["understand_image"]
    },
     "zai-vision": {
      "command": "npx",
      "args": [
        "@z_ai/mcp-server"
      ],
      "env": {
        "Z_AI_API_KEY": "${ZAI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      },
      "directTools": true
    }
  },
  "settings": {
    "toolPrefix": "none",
    "disableProxyTool": true
  }
}
