#!/bin/sh

# configent (https://github.com/raas-dev/configent)
# One command automated macOS/Linux laptop/VM/container bootstrapper.
#
# Copyright(C) 2016- Anssi Syrjäsalo (http://a.syrjasalo.com)
# Licensed under GNU Lesser General Public License v3 (LGPL-3.0).

trap "printf '\nCaught ^C from user - exiting now\n' ; exit 130" INT

bootstrap_started="$(date '+%Y-%m-%d %H:%M:%S')"
bootstrap_start_ts=$(date +%s)
printf '\n🥾 bootstrap started at %s\n' "$bootstrap_started"

rclocal_path="$HOME/.rclocal"
this_path="$(cd "$(dirname "$0")" && pwd)"

# Lima passes the host envvars via /etc/environment. Names often contain spaces.
lima_env_get() {
  _lf=${2:-/etc/environment}
  [ -r "$_lf" ] || return 0
  awk -v k="$1" 'BEGIN { p = "^" k "=" } $0 ~ p { sub(p, ""); print; exit }' "$_lf"
}

### files outside the repo #####################################################

touch "$rclocal_path"

# MISE_GITHUB_TOKEN to avoid GitHub API rate limit
if ! grep -q "export MISE_GITHUB_TOKEN=" "$rclocal_path"; then
  printf "export MISE_GITHUB_TOKEN='%s'\n" \
    "$MISE_GITHUB_TOKEN" >>"$rclocal_path"
fi

# Git identity
if ! grep -q "export EMAIL=" "$rclocal_path"; then
  git_email="${EMAIL:-$(lima_env_get EMAIL)}"
  git_email="${git_email:-$(git config --global user.email)}"
  printf "export EMAIL='%s'\n" "$git_email" >>"$rclocal_path"
fi
if ! grep -q "export GIT_AUTHOR_NAME=" "$rclocal_path"; then
  if [ -n "$GIT_AUTHOR_NAME" ]; then
    git_name=$GIT_AUTHOR_NAME
  else
    git_name=$(lima_env_get GIT_AUTHOR_NAME)
    [ -z "$git_name" ] && git_name=$(git config --global user.name)
    git_name="${git_name:-configent}"
  fi
  printf "export GIT_AUTHOR_NAME='%s'\n" "$git_name" >>"$rclocal_path"
fi
if ! grep -q "export GIT_COMMITTER_NAME=" "$rclocal_path"; then
  if [ -n "$GIT_COMMITTER_NAME" ]; then
    git_name=$GIT_COMMITTER_NAME
  else
    git_name=$(lima_env_get GIT_COMMITTER_NAME)
    [ -z "$git_name" ] && git_name=$(git config --global user.name)
    git_name="${git_name:-configent}"
  fi
  printf "export GIT_COMMITTER_NAME='%s'\n" "$git_name" >>"$rclocal_path"
fi

### files in the repo ##########################################################

"$this_path/symlink_dotfiles"
"$this_path/install_apps"
"$this_path/setup_ide"

# wait for detached background installs (e.g. mise with PARALLEL=true)
if [ -f "${XDG_RUNTIME_DIR:-/tmp}/configent_detached_pids" ]; then
  while read -r pid; do
    # not our child; poll until it exits (pid reuse race is negligible here)
    while kill -0 "$pid" 2>/dev/null; do sleep 5; done
  done <"${XDG_RUNTIME_DIR:-/tmp}/configent_detached_pids"
  rm -f "${XDG_RUNTIME_DIR:-/tmp}/configent_detached_pids"
fi

bootstrap_end_ts=$(date +%s)
bootstrap_took=$((bootstrap_end_ts - bootstrap_start_ts))
printf "\n✅ bootstrap done. started %s, ended %s, took %dm%02ds\n" \
  "$bootstrap_started" "$(date '+%Y-%m-%d %H:%M:%S')" \
  $((bootstrap_took / 60)) $((bootstrap_took % 60))
