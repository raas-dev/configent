#!/bin/sh
# exo-open wrapper: route WebBrowser → brave-wrapper (extension/GPU flags;
# chromium-wrapper until Brave is installed), FileManager → thunar, else passthrough.
case "$1" in
--launch | --launch-webapp)
  case "$2" in
  webbrowser | WebBrowser)
    shift 2
    if [ -x "$HOME/.local/bin/brave-wrapper" ]; then
      exec "$HOME/.local/bin/brave-wrapper" "$@"
    fi
    exec "$HOME/.local/bin/chromium-wrapper" "$@"
    ;;
  FileManager)
    shift 2
    exec /usr/bin/thunar "${1:-$HOME}"
    ;;
  esac
  ;;
esac
exec /usr/bin/exo-open-real "$@"
