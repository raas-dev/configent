[Unit]
Description=org.freedesktop.secrets agent for pass
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/local/bin/pass-secret-service
# ReDB allows a single holder: if a second instance (started from another
# bus during a flap) holds the lock, this one exits 1 — retry until it
# wins instead of staying dead with org.freedesktop.secrets unowned.
Restart=on-failure
RestartSec=2
